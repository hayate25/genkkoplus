#!/bin/bash
clear

[[ "$(whoami)" != "root" ]] && {
    echo "ERROR: Debes ejecutar como root"
    exit 0
}

cd $HOME

echo "=============================================="
echo ""
echo "  ██████╗ ███████╗███╗   ██╗██╗  ██╗██╗  ██╗ ██████╗ "
echo "  ██╔════╝ ██╔════╝████╗  ██║██║ ██╔╝██║ ██╔╝██╔═══██╗"
echo "  ██║  ███╗█████╗  ██╔██╗ ██║█████╔╝ █████╔╝ ██║   ██║"
echo "  ██║   ██║██╔══╝  ██║╚██╗██║██╔═██╗ ██╔═██╗ ██║   ██║"
echo "  ╚██████╔╝███████╗██║ ╚████║██║  ██╗██║  ██╗╚██████╔╝"
echo "   ╚═════╝ ╚══════╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ "
echo ""
echo "           SSHPLUS - GENKKO EDITION"
echo ""
echo "=============================================="
echo ""
echo "  ATENCION: Este script instalara SSHPlus"
echo "  con soporte para SSH, HWID y TOKEN"
echo ""
echo "=============================================="
echo ""
echo -n "Desea continuar con la instalacion? [s/n]: "; read x
[[ $x = @(n|N) ]] && exit

# Función de barra de progreso
fun_bar() {
    comando="$1"
    mensaje="$2"
    (
        eval "$comando" > /dev/null 2>&1
        touch /tmp/fim_bar
    ) &
    tput civis
    echo -ne "  $mensaje ["
    while true; do
        for((i=0; i<20; i++)); do
            echo -ne "#"
            sleep 0.1
        done
        [[ -e /tmp/fim_bar ]] && rm /tmp/fim_bar && break
        echo -ne "]"
        sleep 0.5
        tput cuu1 && tput dl1
        echo -ne "  $mensaje ["
    done
    echo -e "] OK"
    tput cnorm
}

echo ""
echo "VERIFICANDO SISTEMA..."
sleep 1

REPO="https://raw.githubusercontent.com/hayate25/genkkoplus/main"

# Actualizar sistema
echo ""
echo "--- ACTUALIZANDO SISTEMA ---"
fun_bar 'apt-get update -y' '    Actualizando repositorios'

# Instalar paquetes
echo ""
echo "--- INSTALANDO PAQUETES ---"
fun_bar 'apt-get install -y bc python3 htop git screen nano unzip lsof net-tools dos2unix nload jq curl figlet python3-pip at perl sshpass' '    Instalando dependencias'

# Firewall
echo ""
echo "--- CONFIGURANDO FIREWALL ---"
[[ -f "/usr/sbin/ufw" ]] && {
    ufw allow 443/tcp > /dev/null 2>&1
    ufw allow 80/tcp  > /dev/null 2>&1
    ufw allow 8080/tcp > /dev/null 2>&1
    ufw allow 22/tcp  > /dev/null 2>&1
}
echo "    Firewall configurado OK"

# Directorios
echo ""
echo "--- CREANDO DIRECTORIOS ---"
mkdir -p /etc/SSHPlus/senha /etc/SSHPlus/backups /etc/SSHPlus/v2ray /etc/SSHPlus/userteste /etc/SSHPlus/.tmp
touch /etc/SSHPlus/locked_users.db /etc/SSHPlus/hwid.db /etc/SSHPlus/token.db /etc/SSHPlus/temp_users.db /etc/SSHPlus/modo_actual.cfg /etc/SSHPlus/Exp
echo "SSH" > /etc/SSHPlus/modo_actual.cfg
echo "0" > /etc/SSHPlus/Exp
echo "    Directorios creados OK"

# Configurar SSH
grep -v "^PasswordAuthentication" /etc/ssh/sshd_config > /tmp/passlogin && mv /tmp/passlogin /etc/ssh/sshd_config
echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config
echo 'by: @GENKKOSSH' > /usr/lib/licence
[[ $(grep -c "/bin/false" /etc/shells) = '0' ]] && echo "/bin/false" >> /etc/shells

# Zona horaria
echo "America/Argentina/Buenos_Aires" > /etc/timezone
ln -fs /usr/share/zoneinfo/America/Argentina/Buenos_Aires /etc/localtime > /dev/null 2>&1
timedatectl set-timezone America/Argentina/Buenos_Aires > /dev/null 2>&1

# Instalar módulos
echo ""
echo "--- INSTALANDO MODULOS ---"
echo ""

# Lista completa de módulos de tu repositorio
MODULOS=(
    "addhost" "ajuda" "alterarlimite" "alterarsenha" "attscript"
    "badvpn" "banner" "blockt" "bloquear" "bloquear_silencioso"
    "bot" "botssh" "cabecalho" "conexao" "creardemo"
    "criarteste" "delhost" "delscript" "demo_cleaner" "detalhes"
    "droplimiter" "editar_hwid" "expcleaner" "hwid_manager" "infousers"
    "instsqd" "limiter" "menu" "monitor" "mudardata"
    "onlineapp" "otimizar" "reiniciarservicos" "reiniciarsistema" "remover"
    "remover_silencioso" "senharoot" "slow_dns" "slowdns.sh" "speedtest"
    "ssh_manager" "sshmonitor" "swapmemory" "token_manager" "trojan-go"
    "uexpired" "userbackup" "v2ray" "v2raymanager" "verifatt"
    "verifbot" "sshplus_auto_backup" "open.py" "proxy.py" "wsproxy.py" "tools" "velocidad.sh" "fai2ban.sh" "BHTTP" "hcr-server"
)

TOTAL=${#MODULOS[@]}
CONTADOR=0
ERRORES=0

echo "    Total de modulos: $TOTAL"
echo ""

for modulo in "${MODULOS[@]}"; do
    CONTADOR=$((CONTADOR + 1))
    printf "    [%2d/%2d] %-25s " "$CONTADOR" "$TOTAL" "$modulo"
    
    # Descargar
    curl -s "$REPO/Modulos/$modulo" -o /bin/$modulo 2>/dev/null
    
    if [[ -s "/bin/$modulo" ]]; then
        # Limpiar formato
        dos2unix /bin/$modulo > /dev/null 2>&1
        sed -i 's/\r$//' /bin/$modulo 2>/dev/null
        sed -i '1s/^\xEF\xBB\xBF//' /bin/$modulo 2>/dev/null
        chmod +x /bin/$modulo
        
        # Ejecutar si es auto-instalable (cat > /bin/...)
        head -1 /bin/$modulo | grep -q "cat >" && bash /bin/$modulo 2>/dev/null
        
        echo "OK"
    else
        rm -f /bin/$modulo
        echo "ERROR"
        ERRORES=$((ERRORES + 1))
    fi
done

echo ""
echo "----------------------------------------------"
if [[ $ERRORES -gt 0 ]]; then
    echo "  ADVERTENCIA: $ERRORES modulo(s) no se instalaron."
else
    echo "  Todos los modulos instalados correctamente."
fi
echo "----------------------------------------------"

# Mover archivos específicos
[ -f /bin/cabecalho ] && mv /bin/cabecalho /etc/SSHPlus/
[ -f /bin/bot ] && mv /bin/bot /etc/SSHPlus/
[ -f /bin/open.py ] && mv /bin/open.py /etc/SSHPlus/
[ -f /bin/proxy.py ] && mv /bin/proxy.py /etc/SSHPlus/
[ -f /bin/wsproxy.py ] && mv /bin/wsproxy.py /etc/SSHPlus/

# Comando rápido
echo "#!/bin/bash" > /bin/h
echo "/bin/menu" >> /bin/h
chmod +x /bin/h

# Cron
echo ""
echo "--- CONFIGURANDO CRON ---"
crontab -r > /dev/null 2>&1
(
    echo "@reboot /etc/autostart"
    echo "* * * * * /etc/autostart"
    echo "*/5 * * * * /bin/demo_cleaner >> /tmp/demo_cleaner.log 2>&1"
    echo "0 */6 * * * /bin/uexpired"
) | crontab -

# /etc/autostart: se ejecuta al reiniciar la VPS (@reboot) y como respaldo
# cada minuto (cron). Antes quedaba vacio (solo el comentario de cabecera),
# por eso ningun daemon (droplimiter, limiter, monitor, sshmonitor) volvia
# a levantarse tras un reinicio. Ahora cada daemon se verifica con pgrep
# antes de lanzarlo, para no crear procesos duplicados cada minuto.
cat > /etc/autostart << 'AUTOSTART'
#!/bin/bash
# INICIO AUTOMATICO SSHPLUS GENKKO
# Se ejecuta via cron @reboot y cada minuto como respaldo (auto-respawn)

DAEMONS=("droplimiter" "limiter" "monitor" "sshmonitor")

for d in "${DAEMONS[@]}"; do
    bin="/bin/$d"
    [[ -x "$bin" ]] || continue

    if ! pgrep -x "$d" > /dev/null 2>&1; then
        sed -i 's/\r$//' "$bin" 2>/dev/null
        nohup "$bin" >> "/root/${d}.log" 2>&1 &
    fi
done
AUTOSTART
chmod +x /etc/autostart
sed -i 's/\r$//' /etc/autostart
echo "    Cron configurado OK"
echo "    Autostart configurado para: droplimiter, limiter, monitor, sshmonitor"

# Lanzar los daemons ahora mismo, sin esperar al proximo minuto del cron
/etc/autostart

# Base de datos
echo ""
echo "--- CONFIGURANDO BASE DE DATOS ---"
if [ -f "$HOME/usuarios.db" ]; then
    echo "  BD encontrada. [1] Mantener [2] Nueva"
    echo -n "  Opcion: "; read optiondb
    [ "$optiondb" = "2" ] && awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
else
    awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
fi
echo "    Base de datos OK"

# Guardar IP
wget -qO- ipv4.icanhazip.com > /etc/IP 2>/dev/null

# Limpiar
cat /dev/null > ~/.bash_history
history -c
service ssh restart > /dev/null 2>&1
service cron restart > /dev/null 2>&1

clear
echo ""
echo "=============================================="
echo ""
echo "  ██████╗ ███████╗███╗   ██╗██╗  ██╗██╗  ██╗ ██████╗ "
echo "  ██╔════╝ ██╔════╝████╗  ██║██║ ██╔╝██║ ██╔╝██╔═══██╗"
echo "  ██║  ███╗█████╗  ██╔██╗ ██║█████╔╝ █████╔╝ ██║   ██║"
echo "  ██║   ██║██╔══╝  ██║╚██╗██║██╔═██╗ ██╔═██╗ ██║   ██║"
echo "  ╚██████╔╝███████╗██║ ╚████║██║  ██╗██║  ██╗╚██████╔╝"
echo "   ╚═════╝ ╚══════╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ "
echo ""
echo "=============================================="
echo ""
echo "  INSTALACION COMPLETADA EXITOSAMENTE"
echo ""
echo "  Comandos: menu | h"
echo ""
echo "  Modulos instalados: $((TOTAL - ERRORES))/$TOTAL"
echo ""
echo "=============================================="
echo ""

if [[ -x "/bin/menu" ]]; then
    echo -n "Desea abrir el menu ahora? [s/n]: "; read abrirmenu
    [[ $abrirmenu = @(s|S) ]] && exec /bin/menu
fi

echo ""
exit 0
