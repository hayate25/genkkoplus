#!/bin/bash
# sshmonitor - Monitor multi-protocolo con soporte HWID/TOKEN
# Arquitectura: App → ws-epro:80 → Dropbear:90 → HWID/SSH user

HWID_DB="/etc/SSHPlus/hwid.db"
TOKEN_DB="/etc/SSHPlus/token.db"
USUARIOS_DB="/root/usuarios.db"
AUTH_LOG="/var/log/auth.log"

fmt_bytes() {
    local b=${1:-0}
    if [ "$b" -ge 1073741824 ]; then
        awk "BEGIN {printf \"%.1fG\", $b/1073741824}"
    elif [ "$b" -ge 1048576 ]; then
        awk "BEGIN {printf \"%.1fM\", $b/1048576}"
    elif [ "$b" -ge 1024 ]; then
        awk "BEGIN {printf \"%.0fK\", $b/1024}"
    else
        echo "${b}B"
    fi
}

fmt_time() {
    local s=${1:-0}
    ( [ -z "$s" ] || [ "$s" -eq 0 ] ) 2>/dev/null && echo "--:--:--" && return
    printf "%02d:%02d:%02d" $((s/3600)) $(((s%3600)/60)) $((s%60))
}

hwid_to_user() {
    local hwid=$1
    grep -i "|${hwid}|" "$HWID_DB" 2>/dev/null | cut -d'|' -f1
}

token_to_user() {
    local token=$1
    grep -i "|${token}|" "$TOKEN_DB" 2>/dev/null | cut -d'|' -f1
}

# Detecta sesiones Dropbear cuyo login es un HWID (32 hex)
get_hwid_sessions() {
    local active_pids
    active_pids=$(ps aux | awk '/dropbear/ && !/grep/' | awk '{print $2}')
    [ -z "$active_pids" ] && return

    while read -r pid; do
        [ -z "$pid" ] && continue

        hwid=$(grep "dropbear\[${pid}\].*Password auth succeeded" "$AUTH_LOG" 2>/dev/null \
               | tail -1 \
               | grep -oE "for '[a-f0-9]{32}'" \
               | grep -oE "[a-f0-9]{32}")
        [ -z "$hwid" ] && continue

        kill -0 "$pid" 2>/dev/null || continue

        username=$(hwid_to_user "$hwid")
        [ -z "$username" ] && username="[$hwid]"

        elapsed=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')

        down=0; up=0
        if [ -r "/proc/$pid/io" ]; then
            down=$(awk '/^rchar:/{print $2}' /proc/$pid/io 2>/dev/null || echo 0)
            up=$(awk   '/^wchar:/{print $2}' /proc/$pid/io 2>/dev/null || echo 0)
        fi

        echo "$username|HWID-WS|$pid|${elapsed:-0}|${down:-0}|${up:-0}|$hwid"

    done <<< "$active_pids"
}

# Detecta sesiones Dropbear cuyo login es un usuario SSH normal (no HWID, no TOKEN)
get_ssh_sessions() {
    local active_pids
    active_pids=$(ps aux | awk '/dropbear/ && !/grep/' | awk '{print $2}')
    [ -z "$active_pids" ] && return

    while read -r pid; do
        [ -z "$pid" ] && continue

        # Obtener el nombre de usuario autenticado en este PID
        login=$(grep "dropbear\[${pid}\].*Password auth succeeded" "$AUTH_LOG" 2>/dev/null \
                | tail -1 \
                | grep -oE "for '[^']+'" \
                | grep -oE "'[^']+'" \
                | tr -d "'")
        [ -z "$login" ] && continue

        # Saltar si es HWID (32 hex exactos)
        echo "$login" | grep -qE "^[a-f0-9]{32}$" && continue

        # Saltar si es TOKEN (existe en token.db)
        if [ -f "$TOKEN_DB" ] && grep -q "^[^|]*|${login}|" "$TOKEN_DB" 2>/dev/null; then
            continue
        fi

        # Verificar que el proceso sigue activo
        kill -0 "$pid" 2>/dev/null || continue

        # Verificar que existe en usuarios.db
        grep -q "^${login} " "$USUARIOS_DB" 2>/dev/null || continue

        elapsed=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')

        down=0; up=0
        if [ -r "/proc/$pid/io" ]; then
            down=$(awk '/^rchar:/{print $2}' /proc/$pid/io 2>/dev/null || echo 0)
            up=$(awk   '/^wchar:/{print $2}' /proc/$pid/io 2>/dev/null || echo 0)
        fi

        echo "$login|SSH|$pid|${elapsed:-0}|${down:-0}|${up:-0}|-"

    done <<< "$active_pids"
}

# Detecta sesiones Dropbear cuyo login es un TOKEN
get_token_sessions() {
    [ ! -f "$TOKEN_DB" ] && return
    [ ! -s "$TOKEN_DB" ] && return

    local active_pids
    active_pids=$(ps aux | awk '/dropbear/ && !/grep/' | awk '{print $2}')
    [ -z "$active_pids" ] && return

    while read -r pid; do
        [ -z "$pid" ] && continue

        login=$(grep "dropbear\[${pid}\].*Password auth succeeded" "$AUTH_LOG" 2>/dev/null \
                | tail -1 \
                | grep -oE "for '[^']+'" \
                | grep -oE "'[^']+'" \
                | tr -d "'")
        [ -z "$login" ] && continue

        # Saltar si es HWID
        echo "$login" | grep -qE "^[a-f0-9]{32}$" && continue

        # Verificar que existe en token.db como identificador
        username=$(token_to_user "$login")
        [ -z "$username" ] && continue

        kill -0 "$pid" 2>/dev/null || continue

        elapsed=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')

        down=0; up=0
        if [ -r "/proc/$pid/io" ]; then
            down=$(awk '/^rchar:/{print $2}' /proc/$pid/io 2>/dev/null || echo 0)
            up=$(awk   '/^wchar:/{print $2}' /proc/$pid/io 2>/dev/null || echo 0)
        fi

        echo "$username|TOKEN|$pid|${elapsed:-0}|${down:-0}|${up:-0}|$login"

    done <<< "$active_pids"
}

get_wsepro_conn_count() {
    ss -tnp 2>/dev/null \
        | grep -c "127.0.0.1:90.*ws-epro\|ws-epro.*127.0.0.1:90"
}

get_client_ip() {
    ss -tnp 2>/dev/null \
        | awk '/ws-epro.*:80/ && /ESTAB/ {
            for(i=1;i<=NF;i++){
                if($i ~ /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+/ && $i !~ /^45\.|^127\./) {
                    split($i,a,":");
                    print a[1]; exit
                }
            }
        }' | head -1
}

while true; do
    clear
    echo "=============================================="
    echo "       MONITOR DE USUARIOS ONLINE"
    echo "=============================================="
    echo ""

    total_ssh=$(grep -c "|" "$USUARIOS_DB" 2>/dev/null || echo 0)
    total_hwid=$(grep -c "|" "$HWID_DB" 2>/dev/null || echo 0)
    total_token=$(grep -c "|" "$TOKEN_DB" 2>/dev/null || echo 0)

    mapfile -t hwid_sessions  < <(get_hwid_sessions)
    mapfile -t ssh_sessions   < <(get_ssh_sessions)
    mapfile -t token_sessions < <(get_token_sessions)

    all_sessions=("${hwid_sessions[@]}" "${ssh_sessions[@]}" "${token_sessions[@]}")
    online=${#all_sessions[@]}

    ws_conns=$(get_wsepro_conn_count)
    client_ip=$(get_client_ip)

    echo "  Usuarios SSH registrados   : $total_ssh"
    echo "  Usuarios HWID registrados  : $total_hwid"
    echo "  Usuarios TOKEN registrados : $total_token"
    echo "  Sesiones activas           : $online"
    echo "  Túneles ws-epro activos    : $ws_conns"
    [ -n "$client_ip" ] && echo "  IP cliente actual          : $client_ip"
    echo ""
    echo "=============================================="

    if [ "$online" -gt 0 ]; then
        printf "%-15s %-10s %-10s %-12s %-12s %-12s\n" \
            "USUARIO" "TIPO" "CONEX" "DESCARGA" "SUBIDA" "TIEMPO"
        echo "-----------------------------------------------------------------------"

        for entry in "${all_sessions[@]}"; do
            IFS='|' read -r username type pid elapsed down up identifier <<< "$entry"
            [ -z "$username" ] && continue

            if [ "$type" = "HWID-WS" ]; then
                conn=$ws_conns
                [ "$conn" -eq 0 ] && conn=1
            else
                conn=$(who 2>/dev/null | awk -v u="$username" '$1==u' | wc -l)
                [ "$conn" -eq 0 ] && conn=1
            fi

            printf "%-15s %-10s %-10s %-12s %-12s %-12s\n" \
                "$username" \
                "$type" \
                "$conn" \
                "$(fmt_bytes "${down:-0}")" \
                "$(fmt_bytes "${up:-0}")" \
                "$(fmt_time "${elapsed:-0}")"
        done

        echo "-----------------------------------------------------------------------"
        echo ""
        echo "  HWID-WS  : App movil via WebSocket (ws-epro:80 → Dropbear:90)"
        echo "  SSH      : Usuario SSH via Dropbear"
        echo "  TOKEN    : Autenticacion por token"
        echo "  DESCARGA : Bytes leidos por proceso Dropbear"
        echo "  SUBIDA   : Bytes escritos por proceso Dropbear"
        echo "  TIEMPO   : Duracion de la sesion activa"
    else
        echo "  No hay usuarios conectados actualmente"
    fi

    echo ""
    echo "=============================================="
    echo "  [Enter] Actualizar   [Q] Salir"
    echo "=============================================="

    read -t 10 -n 1 key 2>/dev/null
    case "$key" in
        q|Q) echo ""; exit 0 ;;
        *) continue ;;
    esac
done