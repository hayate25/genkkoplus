#!/bin/bash
# sshmonitor - Monitor multi-protocolo con soporte HWID/TOKEN
# Arquitectura: App → ws-epro:80 → Dropbear:90 → HWID/SSH user

HWID_DB="/etc/SSHPlus/hwid.db"
TOKEN_DB="/etc/SSHPlus/token.db"
USUARIOS_DB="/root/usuarios.db"
AUTH_LOG="/var/log/auth.log"

fmt_bytes() {
    local b=${1:-0}
    if [ "$b" -ge 1073741824 ]; then
        awk "BEGIN {printf \"%.1fG\", $b/1073741824}"
    elif [ "$b" -ge 1048576 ]; then
        awk "BEGIN {printf \"%.1fM\", $b/1048576}"
    elif [ "$b" -ge 1024 ]; then
        awk "BEGIN {printf \"%.0fK\", $b/1024}"
    else
        echo "${b}B"
    fi
}

fmt_time() {
    local s=${1:-0}
    ( [ -z "$s" ] || [ "$s" -eq 0 ] ) 2>/dev/null && echo "--:--:--" && return
    printf "%02d:%02d:%02d" $((s/3600)) $(((s%3600)/60)) $((s%60))
}

normalize_hwid() {
    local hwid=${1:-}
    [ -z "$hwid" ] && echo "" && return
    hwid=$(echo "$hwid" | tr -d ' ' | tr '[:upper:]' '[:lower:]')
    hwid="${hwid#h}"
    echo "$hwid"
}

hwid_to_user() {
    local hwid
    hwid=$(normalize_hwid "$1")
    [ -z "$hwid" ] && return
    
    # Buscar en hwid.db probando tanto en la columna 1 como en la columna 2
    awk -F'|' -v value="$hwid" 'BEGIN { IGNORECASE=1 } {
        r1 = $1; sub(/^[hH]/, "", r1);
        r2 = $2; sub(/^[hH]/, "", r2);
        if (tolower(r1) == tolower(value)) { print $2; exit }
        if (tolower(r2) == tolower(value)) { print $1; exit }
    }' "$HWID_DB" 2>/dev/null
}

token_to_user() {
    local token=$1
    grep -i "|${token}|" "$TOKEN_DB" 2>/dev/null | cut -d'|' -f1
}

# Obtiene todas las sesiones Dropbear activas de manera unificada y robusta
get_all_sessions() {
    local active_pids
    active_pids=$(ps aux | awk '/dropbear/ && !/grep/' | awk '{print $2}')
    [ -z "$active_pids" ] && return

    while read -r pid; do
        [ -z "$pid" ] && continue
        kill -0 "$pid" 2>/dev/null || continue

        local username=""
        local type="HWID-WS"
        local identifier="-"

        # 1. Intentar extraer el login del log de autenticación
        login=$(grep "dropbear\[${pid}\].*Password auth succeeded" "$AUTH_LOG" 2>/dev/null \
                | tail -1 \
                | grep -oE "for '[^']+'" \
                | grep -oE "'[^']+'" \
                | tr -d "'")

        if [ -n "$login" ]; then
            clean_login=$(normalize_hwid "$login")
            
            # Verificar si es HWID (por longitud o formato hexadecimal)
            if echo "$clean_login" | grep -qE "^[a-f0-9]{32,}$"; then
                username=$(hwid_to_user "$clean_login")
                [ -z "$username" ] && username="$login"
                type="HWID-WS"
                identifier="$clean_login"
            # Verificar si existe directamente en hwid.db como texto/nombre
            else
                possible_hwid_user=$(hwid_to_user "$login")
                if [ -n "$possible_hwid_user" ]; then
                    username="$possible_hwid_user"
                    type="HWID-WS"
                    identifier="$login"
                # Verificar si es TOKEN
                elif [ -f "$TOKEN_DB" ] && grep -q "^[^|]*|${login}|" "$TOKEN_DB" 2>/dev/null; then
                    username=$(token_to_user "$login")
                    type="TOKEN"
                    identifier="$login"
                # Es usuario SSH tradicional
                else
                    if grep -q "^${login}" "$USUARIOS_DB" 2>/dev/null; then
                        username="$login"
                    else
                        username="$login"
                    fi
                    type="SSH"
                fi
            fi
        else
            continue
        fi

        [ -z "$username" ] && continue

        elapsed=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')

        down=0; up=0
        if [ -r "/proc/$pid/io" ]; then
            down=$(awk '/^rchar:/{print $2}' /proc/$pid/io 2>/dev/null || echo 0)
            up=$(awk   '/^wchar:/{print $2}' /proc/$pid/io 2>/dev/null || echo 0)
        fi

        echo "$username|$type|$pid|${elapsed:-0}|${down:-0}|${up:-0}|$identifier"

    done <<< "$active_pids"
}

get_wsepro_conn_count() {
    ss -tnp 2>/dev/null \
        | grep -c "127.0.0.1:90.*ws-epro\|ws-epro.*127.0.0.1:90"
}

get_client_ip() {
    ss -tnp 2>/dev/null \
        | awk '/ws-epro.*:80/ && /ESTAB/ {
            for(i=1;i<=NF;i++){
                if($i ~ /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+/ && $i !~ /^45\.|^127\./) {
                    split($i,a,":");
                    print a[1]; exit
                }
            }
        }' | head -1
}

while true; do
    clear
    echo "=============================================="
    echo "       MONITOR DE USUARIOS ONLINE"
    echo "=============================================="
    echo ""

    total_ssh=$(grep -c "|" "$USUARIOS_DB" 2>/dev/null || echo 0)
    total_hwid=$(grep -c "|" "$HWID_DB" 2>/dev/null || echo 0)
    total_token=$(grep -c "|" "$TOKEN_DB" 2>/dev/null || echo 0)

    mapfile -t all_sessions < <(get_all_sessions)
    online=${#all_sessions[@]}

    ws_conns=$(get_wsepro_conn_count)
    client_ip=$(get_client_ip)

    echo "  Usuarios SSH registrados   : $total_ssh"
    echo "  Usuarios HWID registrados  : $total_hwid"
    echo "  Usuarios TOKEN registrados : $total_token"
    echo "  Sesiones activas           : $online"
    echo "  Túneles ws-epro activos    : $ws_conns"
    [ -n "$client_ip" ] && echo "  IP cliente actual          : $client_ip"
    echo ""
    echo "=============================================="

    if [ "$online" -gt 0 ]; then
        printf "%-15s %-10s %-10s %-12s %-12s %-12s\n" \
            "USUARIO" "TIPO" "CONEX" "DESCARGA" "SUBIDA" "TIEMPO"
        echo "-----------------------------------------------------------------------"

        for entry in "${all_sessions[@]}"; do
            IFS='|' read -r username type pid elapsed down up identifier <<< "$entry"
            [ -z "$username" ] && continue

            if [ "$type" = "HWID-WS" ] || [ "$type" = "TOKEN" ]; then
                conn=$ws_conns
                [ "$conn" -eq 0 ] && conn=1
            else
                conn=$(who 2>/dev/null | awk -v u="$username" '$1==u' | wc -l)
                [ "$conn" -eq 0 ] && conn=1
            fi

            printf "%-15s %-10s %-10s %-12s %-12s %-12s\n" \
                "$username" \
                "$type" \
                "$conn" \
                "$(fmt_bytes "${down:-0}")" \
                "$(fmt_bytes "${up:-0}")" \
                "$(fmt_time "${elapsed:-0}")"
        done

        echo "-----------------------------------------------------------------------"
        echo ""
        echo "  HWID-WS  : App movil via WebSocket (ws-epro:80 → Dropbear:90)"
        echo "  SSH      : Usuario SSH via Dropbear"
        echo "  TOKEN    : Autenticacion por token"
        echo "  DESCARGA : Bytes leidos por proceso Dropbear"
        echo "  SUBIDA   : Bytes escritos por proceso Dropbear"
        echo "  TIEMPO   : Duracion de la sesion activa"
    else
        echo "  No hay usuarios conectados actualmente"
    fi

    echo ""
    echo "=============================================="
    echo "  [Enter] Actualizar   [Q] Salir"
    echo "=============================================="

    read -t 10 -n 1 key 2>/dev/null
    case "$key" in
        q|Q) echo ""; exit 0 ;;
        *) continue ;;
    esac
done
