
#!/bin/bash
#GENKKOSSH
# infousers - Módulo de información de usuarios
# Compatible con sistema SSHPlus (IDs dinámicos)
# Versión sin colores - Muestra según modo actual

clear

MODO_ACTUAL="/etc/SSHPlus/modo_actual.cfg"
database="/root/usuarios.db"
temp_db="/etc/SSHPlus/temp_users.db"

# Detectar modo
if [ -f "$MODO_ACTUAL" ]; then
    modo=$(cat "$MODO_ACTUAL")
else
    modo="SSH"
fi

get_validez() {
    local fecha="$1"

    if [[ -z "$fecha" ]] || [[ "$fecha" == "never" ]]; then
        echo "Nunca"
        return
    fi

    databr=$(date -d "$fecha" +"%Y%m%d" 2>/dev/null)
    hoje=$(date -d today +"%Y%m%d")

    if [ "$hoje" -ge "$databr" ] 2>/dev/null; then
        echo "VENCIDO"
    else
        dias=$(( ($(date -ud "$fecha" +%s) - $(date -ud "$(date +%Y-%m-%d)" +%s)) / 86400 ))
        if [ "$dias" -lt 0 ]; then
            echo "VENCIDO"
        else
            echo "$dias Dias"
        fi
    fi
}

append_entry() {
    local usuario="$1"
    local tipo="$2"
    local clave="$3"
    local limite="$4"
    local validez="$5"

    printf '%s|%s|%s|%s|%s\n' "$usuario" "$tipo" "$clave" "$limite" "$validez" >> "$tmp_entries"
}

# Archivo temporal para reunir todas las entradas del modo activo
# y poder mostrarlas en una sola lista ordenada.
tmp_entries=$(mktemp)
trap 'rm -f "$tmp_entries"' EXIT

id=0
total_usuarios=0

case "$modo" in
    SSH)
        if [ -f "$database" ]; then
            while IFS=' ' read -r user limit; do
                [[ -z "$user" ]] && continue
                if ! grep -q "^$user:" /etc/passwd; then
                    continue
                fi

                if [[ -e "/etc/SSHPlus/senha/$user" ]]; then
                    senha=$(cat "/etc/SSHPlus/senha/$user")
                else
                    senha="Null"
                fi

                [[ -z "$limit" ]] && limit="1"

                datauser=$(chage -l "$user" 2>/dev/null | grep -i "Account expires" | awk -F: '{print $2}' | sed 's/^[[:space:]]*//')
                data=$(get_validez "$datauser")

                append_entry "$user" "SSH" "$senha" "$limit" "$data"
            done < "$database"
        fi

        if [ -f "$temp_db" ]; then
            while IFS='|' read -r user modo_temp exp; do
                [[ -z "$user" ]] && continue
                [[ "$modo_temp" != "SSH" ]] && continue
                if ! grep -q "^$user:" /etc/passwd; then
                    continue
                fi

                if [[ -e "/etc/SSHPlus/senha/$user" ]]; then
                    senha=$(cat "/etc/SSHPlus/senha/$user")
                else
                    senha="Null"
                fi

                data=$(get_validez "$exp")
                append_entry "$user" "DEMO" "$senha" "N/A" "$data"
            done < "$temp_db"
        fi
        ;;

    HWID)
        if [ -f "/etc/SSHPlus/hwid.db" ]; then
            while IFS='|' read -r user hwid fecha; do
                [[ -z "$user" ]] && continue

                hwid_short="${hwid:0:12}..."
                data=$(get_validez "$fecha")
                append_entry "$user" "HWID" "$hwid_short" "N/A" "$data"
            done < "/etc/SSHPlus/hwid.db"
        fi

        if [ -f "$temp_db" ]; then
            while IFS='|' read -r user modo_temp exp; do
                [[ -z "$user" ]] && continue
                [[ "$modo_temp" != "HWID" ]] && continue
                if ! grep -q "^$user:" /etc/passwd; then
                    continue
                fi

                data=$(get_validez "$exp")
                append_entry "$user" "DEMO" "$user" "N/A" "$data"
            done < "$temp_db"
        fi
        ;;

    TOKEN)
        if [ -f "/etc/SSHPlus/token.db" ]; then
            while IFS='|' read -r user token pass fecha; do
                [[ -z "$user" ]] && continue

                token_short="${token:0:12}..."
                data=$(get_validez "$fecha")
                append_entry "$user" "TOKEN" "$token_short" "N/A" "$data"
            done < "/etc/SSHPlus/token.db"
        fi

        if [ -f "$temp_db" ]; then
            while IFS='|' read -r user modo_temp exp; do
                [[ -z "$user" ]] && continue
                [[ "$modo_temp" != "TOKEN" ]] && continue
                if ! grep -q "^$user:" /etc/passwd; then
                    continue
                fi

                data=$(get_validez "$exp")
                append_entry "$user" "DEMO" "$user" "N/A" "$data"
            done < "$temp_db"
        fi
        ;;
esac

if [ -s "$tmp_entries" ]; then
    while IFS='|' read -r user tipo clave limite validez; do
        [[ -z "$user" ]] && continue
        id=$((id + 1))
        total_usuarios=$((total_usuarios + 1))
        printf "[%02d]  %-15s %-8s %-13s %-10s %-15s\n" "$id" "$user" "$tipo" "$clave" "$limite" "$validez"
    done < "$tmp_entries"
fi

echo "----------------------------------------------------------------------------"

if [[ $total_usuarios -eq 0 ]]; then
    echo "  No hay usuarios registrados en modo $modo"
fi

echo ""

_tuser=$total_usuarios
_ons=$(ps -x 2>/dev/null | grep sshd | grep -v root | grep priv | wc -l)
[[ -e /etc/default/dropbear ]] && _drp=$(ps aux 2>/dev/null | grep dropbear | grep -v grep | wc -l) && _ondrp=$(($_drp - 1)) || _ondrp="0"
[[ -e /etc/openvpn/openvpn-status.log ]] && _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log 2>/dev/null) || _onop="0"
_onli=$(($_ons + $_onop + $_ondrp))

[[ "$(cat /etc/SSHPlus/Exp 2>/dev/null)" != "" ]] && _expuser=$(cat /etc/SSHPlus/Exp) || _expuser="0"

echo "=============================================="
echo "  TOTAL USUARIOS: $_tuser"
echo "  ONLINE: $_onli"
echo "  EXPIRADOS: $_expuser"
echo "  MODO ACTUAL: $modo"
echo "=============================================="
echo ""

exit 0
