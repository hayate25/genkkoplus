#!/bin/bash
# ssh_manager - Gestion de usuarios SSH (con desconexion forzada)

DB_SSH="/root/usuarios.db"
SENHA_DIR="/etc/SSHPlus/senha"
AUTH_LOG="/var/log/auth.log"

mkdir -p "$SENHA_DIR"
touch "$DB_SSH"

nombre_unico() {
    local nombre="$1"
    [ -z "$nombre" ] && return 1

    if grep -q "^$nombre " "$DB_SSH" 2>/dev/null; then
        return 1
    fi

    if grep -q "^$nombre|" /etc/SSHPlus/hwid.db 2>/dev/null; then
        return 1
    fi

    if grep -q "^$nombre|" /etc/SSHPlus/token.db 2>/dev/null; then
        return 1
    fi

    if grep -q "^$nombre:" /etc/passwd 2>/dev/null; then
        return 1
    fi

    return 0
}

password_unico() {
    local pass="$1"
    local file
    [ -z "$pass" ] && return 1

    for file in "$SENHA_DIR"/*; do
        [ -f "$file" ] || continue
        if [ "$(cat "$file" 2>/dev/null)" = "$pass" ]; then
            return 1
        fi
    done

    return 0
}

sanitize_db() {
    local tmp_db
    tmp_db=$(mktemp)

    while IFS=' ' read -r user limit pass exp_date resto; do
        [[ -z "$user" ]] && continue
        if grep -q "^$user:" /etc/passwd 2>/dev/null; then
            printf '%s %s %s %s %s\n' "$user" "$limit" "$pass" "$exp_date" "$resto" >> "$tmp_db"
        fi
    done < "$DB_SSH"

    mv "$tmp_db" "$DB_SSH"
}

listar() {
    echo "======================================================================"
    echo "  USUARIOS SSH"
    echo "======================================================================"
    if [[ ! -s "$DB_SSH" ]]; then
        echo "  No hay usuarios SSH"
        return
    fi
    
    # Obtener conexiones activas
    local conexiones=$(ss -tnp 2>/dev/null | grep "dropbear" | grep ESTAB)
    
    echo "  ID | USUARIO  | LIM | CONECT | PASSWORD | EXPIRACION"
    echo "  ---|----------|-----|--------|----------|------------"
    local i=1
    while IFS=' ' read -r user limite pass exp_date resto; do
        [[ -z "$user" ]] && continue
        local estado="NO"
        if echo "$conexiones" | while read line; do
            pid=$(echo "$line" | grep -oP 'pid=\K[0-9]+')
            grep -q "dropbear\[$pid\].*Password auth succeeded for '$user'" "$AUTH_LOG" 2>/dev/null && echo "SI" && break
        done | grep -q "SI"; then
            estado="SI"
        fi
        
        # Si no hay pass o exp en el db (usuarios viejos), mostrar N/A
        local d_pass=${pass:-"N/A"}
        local d_exp=${exp_date:-"N/A"}
        
        printf "  %2d | %-8s | %3s | %-6s | %-8s | %s\n" "$i" "$user" "$limite" "$estado" "$d_pass" "$d_exp"
        i=$((i+1))
    done < "$DB_SSH"
    echo "======================================================================"
}

crear() {
    echo "=========================================="
    echo "  CREAR USUARIO SSH"
    echo "=========================================="

    sanitize_db
    
    read -p "  Usuario (min 4): " username
    [[ -z "$username" ]] && return 1

    if ! nombre_unico "$username"; then
        echo "  ERROR: El nombre '$username' ya existe"
        return 1
    fi
    
    read -p "  Contrasena (min 4): " password
    [[ -z "$password" ]] && return 1

    if ! password_unico "$password"; then
        echo "  ERROR: La contraseña ya existe"
        return 1
    fi
    
    read -p "  Limite conexiones (1-99): " limite
    [[ ! "$limite" =~ ^[0-9]+$ ]] && limite=1
    
    read -p "  Dias expiracion (1-365): " dias
    [[ ! "$dias" =~ ^[0-9]+$ ]] && dias=30
    
    local final=$(date "+%Y-%m-%d" -d "+$dias days")

    useradd -e "$final" -M -s /bin/false "$username" >/dev/null 2>&1

    if ! getent passwd "$username" >/dev/null 2>&1; then
        echo "  FALLO EL PROCESO"
        echo "  ERROR: No se pudo crear el usuario en el sistema"
        echo "  No se guardo en la base de datos."
        return 1
    fi

    if ! echo "$username:$password" | chpasswd >/dev/null 2>&1; then
        userdel -f "$username" >/dev/null 2>&1
        rm -f "$SENHA_DIR/$username"
        echo "  FALLO EL PROCESO"
        echo "  ERROR: No se pudo asignar la contraseña"
        echo "  No se guardo en la base de datos."
        return 1
    fi

    # Guardamos: usuario limite contraseña fecha_expiracion
    local tmp_db
    tmp_db=$(mktemp)
    cat "$DB_SSH" > "$tmp_db" 2>/dev/null
    printf '%s %s %s %s\n' "$username" "$limite" "$password" "$final" >> "$tmp_db"
    mv "$tmp_db" "$DB_SSH"
    echo "$password" > "$SENHA_DIR/$username"
    echo "  OK: Usuario $username creado"
    echo "  Expira: $final"
}

borrar() {
    listar
    echo ""
    read -p "  ID a borrar: " id
    
    local linea=$(sed -n "${id}p" "$DB_SSH")
    local user=$(echo "$linea" | cut -d' ' -f1)
    if [[ -z "$user" ]]; then
        echo "  ERROR: ID invalido"
        return
    fi
    
    echo ""
    echo "  Usuario: $user"
    read -p "  Confirmar borrado (s/N): " conf
    [[ "$conf" != "s" ]] && return
    
    echo ""
    echo "  Desconectando $user..."
    
    # Buscar el PID de dropbear para este usuario
    local target_pid=$(grep "Password auth succeeded for '$user'" "$AUTH_LOG" 2>/dev/null | tail -1 | grep -oP 'dropbear\[\K[0-9]+')
    
    if [[ -n "$target_pid" ]]; then
        echo "    Matando dropbear PID $target_pid"
        kill -9 "$target_pid" 2>/dev/null
        sleep 1
    fi
    
    # Matar cualquier proceso remanente
    pkill -9 -u "$user" 2>/dev/null
    
    # Eliminar del sistema
    userdel -f "$user" 2>/dev/null
    
    # Limpiar archivos
    local tmp_db=$(mktemp)
    grep -Fv -- "$linea" "$DB_SSH" > "$tmp_db" 2>/dev/null
    mv "$tmp_db" "$DB_SSH"
    rm -f "$SENHA_DIR/$user" 2>/dev/null
    
    echo "  OK: Usuario $user eliminado"
}

case "$1" in
    list|ls)    listar ;;
    create|add) crear ;;
    delete|del) borrar ;;
    *)
        echo "ssh_manager - Gestion de usuarios SSH"
        echo "Uso: ssh_manager [list|create|delete]"
        ;;
esac
