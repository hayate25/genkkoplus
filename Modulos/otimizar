fun_bar() {
	comando[0]="$1"
	comando[1]="$2"
	(
		[[ -e $HOME/fim ]] && rm $HOME/fim
		${comando[0]} -y >/dev/null 2>&1
		${comando[1]} -y >/dev/null 2>&1
		touch $HOME/fim
	) >/dev/null 2>&1 &
	tput civis
	echo -ne "     AGUARDE - ["
	while true; do
		for ((i = 0; i < 18; i++)); do
			echo -ne "#"
			sleep 0.1s
		done
		[[ -e $HOME/fim ]] && rm $HOME/fim && break
		echo -e "]"
		sleep 1s
		tput cuu1
		tput dl1
		echo -ne "     AGUARDE - ["
	done
	echo -e "] - OK !"
	tput cnorm
}
