# ─── Total de conexiones combinadas por usuario ───────────────────────────────
fun_total_count() {
    local target_user="$1"
    local drop=$(fun_drop | grep "$target_user" | wc -l)
    local proc=$(fun_proc_count "$target_user")
    local ss_c=$(fun_ss_count "$target_user")

    # Evita doble conteo: si proc ya cuenta lo que ss ve, usa solo el mayor
    local proxy_count=$proc
    [ $ss_c -gt $proc ] && proxy_count=$ss_c

    echo $((drop + proxy_count))
}

# ─── Kill de todos los protocolos para un usuario ────────────────────────────
fun_kill_user() {
    local target_user="$1"

    # 1. Matar procesos Dropbear del usuario
    fun_drop | grep "$target_user" | awk '{print $2}' | while read p; do
        kill "$p" 2>/dev/null
    done

    # 2. Matar procesos proxy (ws-epro, Python, WebSocket)
    fun_proc_pids "$target_user" | while read p; do
        kill "$p" 2>/dev/null
    done

    # 3. Matar cualquier proceso remanente del usuario en ss ESTABLISHED
    local user_pids=$(ps aux | grep -v grep | awk -v u="$target_user" '$1==u {print $2}')
    for p in $user_pids; do
        if ss -tp | grep -q "pid=$p,"; then
            kill "$p" 2>/dev/null
        fi
    done
}

# ─── Loop principal ───────────────────────────────────────────────────────────
if [ ! -f "$database" ]; then
    echo "Archivo $database no encontrado"
    exit 1
fi

while true; do
    clear
    echo -e "\E[42;1;37m               LIMITER DROPBEAR                \E[0m"
    echo -e "\E[42;1;37m Usuario                        Conexao/Limite  \E[0m"

    while read usline; do
        user="$(echo $usline | cut -d' ' -f1)"
        s2ssh="$(echo $usline | cut -d' ' -f2)"

        if [ -z "$user" ]; then
            echo "" > /dev/null
            continue
        fi

        s3total=$(fun_total_count "$user")

        tput setaf 3; tput bold
        printf '  %-35s%s\n' "$user" "$s3total/$s2ssh"
        tput sgr0

        if [ "$s3total" -gt "$s2ssh" ]; then
            echo -e "\E[41;1;37m Usuário desconectado por ultrapassar o limite! \E[0m"
            fun_kill_user "$user"
        fi

    done < "$database"

    sleep 6
done
