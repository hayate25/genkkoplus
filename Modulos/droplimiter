#!/bin/bash
database="/root/usuarios.db"
echo $$ > /tmp/pids

# ─── Detección Dropbear ───────────────────────────────────────────────────────
fun_drop() {
    port_dropbear=$(ps aux | grep dropbear | awk 'NR==1{print $17}')
    log=/var/log/auth.log
    loginsukses='Password auth succeeded'
    pids=$(ps ax | grep dropbear | grep " $port_dropbear" | awk '{print $1}')
    for pid in $pids; do
        pidlogs=$(grep $pid $log | grep "$loginsukses" | awk '{print $3}')
        i=0
        for pidend in $pidlogs; do
            let i=i+1
        done
        if [ $pidend ]; then
            login=$(grep $pid $log | grep "$pidend" | grep "$loginsukses")
            PID=$pid
            user=$(echo $login | awk '{print $10}' | sed -r "s/'/ /g")
            waktu=$(echo $login | awk '{print $2"-"$1,$3}')
            while [ ${#waktu} -lt 13 ]; do waktu=$waktu" "; done
            while [ ${#user} -lt 16 ]; do user=$user" "; done
            while [ ${#PID} -lt 8 ];  do PID=$PID" ";  done
            echo "$user $PID $waktu"
        fi
    done
}

# ─── Detección por proceso (ws-epro, Python proxy, WebSocket, etc.) ───────────
# Busca procesos donde el nombre de usuario aparece como argumento
fun_proc_count() {
    local target_user="$1"
    local count=0

    # ws-epro: busca procesos que contengan el usuario en sus argumentos
    local wse=$(ps aux | grep -v grep | grep -E "ws-epro|wsepro" | grep "$target_user" | wc -l)

    # Python proxy scripts: procesos python/python3 con el usuario como argumento
    local pyp=$(ps aux | grep -v grep | grep -E "python[23]?" | grep "$target_user" | wc -l)

    # WebSocket genérico: procesos node/websockify/wstunnel con el usuario
    local wsg=$(ps aux | grep -v grep | grep -E "websockify|wstunnel|ws-tunnel" | grep "$target_user" | wc -l)

    count=$((wse + pyp + wsg))
    echo $count
}

# Devuelve los PIDs de procesos proxy asociados al usuario (para kill)
fun_proc_pids() {
    local target_user="$1"
    ps aux | grep -v grep \
           | grep -E "ws-epro|wsepro|python[23]?|websockify|wstunnel|ws-tunnel" \
           | grep "$target_user" \
           | awk '{print $2}'
}

# ─── Detección por conexiones SS (túneles activos del usuario) ────────────────
# Cuenta conexiones ESTABLISHED vinculadas a procesos del usuario vía ss
fun_ss_count() {
    local target_user="$1"
    # Obtiene PIDs del usuario (excluyendo bash/sh para no contar su sesión de login)
    local user_pids=$(ps aux | grep -v grep | awk -v u="$target_user" '$1==u && $11!~/bash|sh$|sshd/ {print $2}')
    local count=0
    for p in $user_pids; do
        local c=$(ss -tp | grep "pid=$p," | grep ESTAB | wc -l)
        count=$((count + c))
    done
    echo $count
}

