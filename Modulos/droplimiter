#!/bin/bash
database="/root/usuarios.db"
echo $$ > /tmp/pids

# ─── Detección Dropbear (CORREGIDA) ───────────────────────────────────────────
# Antes: detectaba el puerto vía ps aux (campo 17, poco fiable) y luego
#        filtraba PIDs por substring de puerto -> generaba listas de PIDs
#        incorrectas o vacías.
# Ahora: se obtienen directamente los PIDs de los procesos dropbear hijos
#        (uno por sesión) y se ancla la búsqueda en auth.log con
#        "dropbear[PID]:" para evitar falsos positivos por substring.
#        Además se usa la ULTIMA línea de login real (tail -n1) en vez de
#        una variable $pidend que podía quedar con un valor obsoleto de
#        una iteración anterior si el PID actual no tenía coincidencias.
fun_drop() {
    log=/var/log/auth.log
    loginsukses='Password auth succeeded'

    # Todos los PIDs de procesos dropbear (cada sesión = un proceso hijo)
    pids=$(pgrep -x dropbear)

    for pid in $pids; do
        # Anclado: solo líneas que mencionen exactamente este PID de dropbear
        login=$(grep "dropbear\[$pid\]:" "$log" | grep "$loginsukses" | tail -n1)

        # Si no hay login registrado para este PID, se ignora (antes seguía
        # usando el $pidend de la vuelta anterior)
        [ -z "$login" ] && continue

        PID=$pid
        user=$(echo "$login" | awk '{print $10}' | sed -r "s/'//g")
        waktu=$(echo "$login" | awk '{print $2"-"$1,$3}')

        while [ ${#waktu} -lt 13 ]; do waktu=$waktu" "; done
        while [ ${#user} -lt 16 ]; do user=$user" "; done
        while [ ${#PID} -lt 8 ];  do PID=$PID" ";  done

        echo "$user $PID $waktu"
    done
}

# ─── Detección por proceso (ws-epro, Python proxy, WebSocket, etc.) ───────────
fun_proc_count() {
    local target_user="$1"
    local count=0

    local wse=$(ps aux | grep -v grep | grep -E "ws-epro|wsepro" | grep "$target_user" | wc -l)
    local pyp=$(ps aux | grep -v grep | grep -E "python[23]?" | grep "$target_user" | wc -l)
    local wsg=$(ps aux | grep -v grep | grep -E "websockify|wstunnel|ws-tunnel" | grep "$target_user" | wc -l)

    count=$((wse + pyp + wsg))
    echo $count
}

fun_proc_pids() {
    local target_user="$1"
    ps aux | grep -v grep \
           | grep -E "ws-epro|wsepro|python[23]?|websockify|wstunnel|ws-tunnel" \
           | grep "$target_user" \
           | awk '{print $2}'
}

# ─── Detección por conexiones SS (túneles activos del usuario) ────────────────
fun_ss_count() {
    local target_user="$1"
    local user_pids=$(ps aux | grep -v grep | awk -v u="$target_user" '$1==u && $11!~/bash|sh$|sshd/ {print $2}')
    local count=0
    for p in $user_pids; do
        local c=$(ss -tp | grep "pid=$p," | grep ESTAB | wc -l)
        count=$((count + c))
    done
    echo $count
}

# ─── Total de conexiones combinadas por usuario ───────────────────────────────
fun_total_count() {
    local target_user="$1"
    local drop=$(fun_drop | grep "$target_user" | wc -l)
    local proc=$(fun_proc_count "$target_user")
    local ss_c=$(fun_ss_count "$target_user")

    local proxy_count=$proc
    [ $ss_c -gt $proc ] && proxy_count=$ss_c

    echo $((drop + proxy_count))
}

# ─── Kill de todos los protocolos para un usuario ────────────────────────────
fun_kill_user() {
    local target_user="$1"

    fun_drop | grep "$target_user" | awk '{print $2}' | while read p; do
        kill "$p" 2>/dev/null
    done

    fun_proc_pids "$target_user" | while read p; do
        kill "$p" 2>/dev/null
    done

    local user_pids=$(ps aux | grep -v grep | awk -v u="$target_user" '$1==u {print $2}')
    for p in $user_pids; do
        if ss -tp | grep -q "pid=$p,"; then
            kill "$p" 2>/dev/null
        fi
    done
}

# ─── Loop principal ───────────────────────────────────────────────────────────
if [ ! -f "$database" ]; then
    echo "Archivo $database no encontrado"
    exit 1
fi

while true; do
    clear
    echo -e "\E[42;1;37m               LIMITER DROPBEAR                \E[0m"
    echo -e "\E[42;1;37m Usuario                        Conexao/Limite  \E[0m"

    while read usline; do
        user="$(echo $usline | cut -d' ' -f1)"
        s2ssh="$(echo $usline | cut -d' ' -f2)"

        if [ -z "$user" ]; then
            continue
        fi

        s3total=$(fun_total_count "$user")

        tput setaf 3; tput bold
        printf '  %-35s%s\n' "$user" "$s3total/$s2ssh"
        tput sgr0

        if [ "$s3total" -gt "$s2ssh" ]; then
            echo -e "\E[41;1;37m Usuário desconectado por ultrapassar o limite! \E[0m"
            fun_kill_user "$user"
        fi

    done < "$database"

    sleep 6
done
