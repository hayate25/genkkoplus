#!/bin/bash
#GENKkKOSSH
# mudardata - Módulo para editar fecha de vencimiento de usuarios
# Compatible con sistema SSHPlus (IDs dinámicos)
# Versión sin colores para compatibilidad con bots

MODO_ACTUAL="/etc/SSHPlus/modo_actual.cfg"
modo=$(cat "$MODO_ACTUAL" 2>/dev/null || echo "SSH")
LOCKED_LIST="/etc/SSHPlus/locked_users.db"
SENHA_DIR="/etc/SSHPlus/senha"

# ================================================================
# MENSAJES DE SALIDA (limpios y predecibles para lectura por app)
# ================================================================

exito_menu() {
    local mensaje="$1"
    clear
    echo ""
    echo "$mensaje"
    echo ""
    read -t 30 -p "Presione ENTER para continuar (o espere 30s)... "
    echo ""
}

fallo_menu() {
    local mensaje="$1"
    echo ""
    echo "FALLO EL PROCESO"
    echo "$mensaje"
    echo ""
    read -p "ENTER para continuar..."
}

clear
echo "=============================================="
echo "         EDITAR FECHA DE VENCIMIENTO - $modo"
echo "=============================================="
echo ""

# ── Si es HWID o TOKEN usar lógica propia ──────────────
if [[ "$modo" == "HWID" || "$modo" == "TOKEN" ]]; then

    case "$modo" in
        HWID)  database="/etc/SSHPlus/hwid.db" ;;
        TOKEN) database="/etc/SSHPlus/token.db" ;;
    esac

    if [ ! -f "$database" ] || [ ! -s "$database" ]; then
        fallo_menu "No hay usuarios $modo registrados"
        exit 1
    fi

    echo "  LISTA DE USUARIOS $modo Y FECHAS DE VENCIMIENTO:"
    echo "  --------------------------------------------"
    echo ""

    id=0
    while IFS='|' read -r nombre identificador exp; do
        [[ -z "$nombre" ]] && continue
        id=$((id + 1))
        if [[ -z "$exp" ]] || [[ "$exp" == "never" ]]; then
            fecha="00/00/0000"
            estado="SIN FECHA"
        else
            fecha=$(date -d "$exp" '+%d/%m/%Y' 2>/dev/null || echo "ERROR")
            databr=$(date -d "$exp" +"%Y%m%d" 2>/dev/null)
            hoje=$(date +"%Y%m%d")
            if [ "$hoje" -ge "$databr" ] 2>/dev/null; then
                estado="VENCIDO"
            else
                dias_rest=$(( ($(date -d "$exp" +%s) - $(date +%s)) / 86400 ))
                estado="${dias_rest}d restantes"
            fi
        fi
        printf "  [%02d] - %-20s | %-10s | %s\n" "$id" "$nombre" "$fecha" "$estado"
    done < "$database"

    if [[ $id -eq 0 ]]; then
        fallo_menu "No hay usuarios $modo registrados en el sistema."
        exit 1
    fi

    echo ""
    echo "  --------------------------------------------"
    echo "  Total de usuarios: $id"
    echo ""
    echo -n "  Seleccione un usuario por ID [1-$id]: "
    read option

    if [[ -z $option ]]; then
        fallo_menu "Debe seleccionar un ID"
        exit 1
    fi
    if ! [[ "$option" =~ ^[0-9]+$ ]]; then
        fallo_menu "Debe ingresar un número válido"
        exit 1
    fi
    if [[ $option -lt 1 ]] || [[ $option -gt $id ]]; then
        fallo_menu "ID fuera de rango [1-$id]"
        exit 1
    fi

    # Obtener línea seleccionada
    current=0
    while IFS='|' read -r nombre identificador exp; do
        [[ -z "$nombre" ]] && continue
        current=$((current + 1))
        if [ $current -eq $option ]; then
            usuario="$nombre"
            hwid_tok="$identificador"
            exp_actual="$exp"
            linea_num=$current
            break
        fi
    done < "$database"

    if [[ -z "$usuario" ]]; then
        fallo_menu "Usuario no encontrado"
        exit 1
    fi

    fecha_actual=$(date -d "$exp_actual" '+%d/%m/%Y' 2>/dev/null || echo "Sin fecha")

    echo ""
    echo "  Usuario seleccionado: $usuario"
    echo "  Identificador: $hwid_tok"
    echo "  Vencimiento actual: $fecha_actual"
    echo ""
    echo "  FORMATOS ACEPTADOS:"
    echo "    - Fecha: DD/MM/AAAA (Ejemplo: 21/04/2024)"
    echo "    - Dias:  30 (30 dias a partir de hoy)"
    echo ""
    echo -n "  Nueva fecha o dias para el usuario $usuario: "
    read inputdate

    if [[ -z $inputdate ]]; then
        fallo_menu "Debe ingresar una fecha o número de días"
        exit 1
    fi

    if [[ "$inputdate" =~ "/" ]]; then
        sysdate="$(echo "$inputdate" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
        udata="$inputdate"
    else
        if ! [[ "$inputdate" =~ ^[0-9]+$ ]]; then
            fallo_menu "Debe ingresar un número de días válido"
            exit 1
        fi
        if [[ $inputdate -lt 1 ]]; then
            fallo_menu "Los días deben ser mayor que 0"
            exit 1
        fi
        udata=$(date "+%d/%m/%Y" -d "+$inputdate days")
        sysdate="$(echo "$udata" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
    fi

    if ! date "+%Y-%m-%d" -d "$sysdate" > /dev/null 2>&1; then
        fallo_menu "Fecha inválida o inexistente"
        exit 1
    fi

    today="$(date +"%Y%m%d")"
    timemachine="$(date -d "$sysdate" +"%Y%m%d")"
    if [ "$today" -gt "$timemachine" ]; then
        fallo_menu "La fecha ingresada es anterior a hoy"
        exit 1
    fi

    # Actualizar en la base de datos
    sed -i "${linea_num}s/|[^|]*$/|${sysdate}/" "$database"

    # Actualizar expiración del usuario Linux (el identificador es el usuario del sistema)
    usermod -e "$sysdate" "$hwid_tok" 2>/dev/null
    chage -E "$sysdate" "$hwid_tok" 2>/dev/null
    usermod -U "$hwid_tok" 2>/dev/null
    passwd -u "$hwid_tok" 2>/dev/null

    # ── Desbloqueo automático y eliminación de lista de bloqueados ──
    user_to_check="$hwid_tok"
    [[ "$modo" == "TOKEN" ]] && user_to_check="$usuario"
    
    if grep -qxF "$user_to_check" "$LOCKED_LIST" 2>/dev/null; then
        if [[ -f "$SENHA_DIR/$user_to_check" ]]; then
            orig=$(cat "$SENHA_DIR/$user_to_check" | tr -d '\r')
            echo "$user_to_check:$orig" | chpasswd 2>/dev/null
        fi
        usermod -U "$user_to_check" 2>/dev/null
        passwd -u "$user_to_check" 2>/dev/null
        sed -i "/^$user_to_check$/d" "$LOCKED_LIST" 2>/dev/null
    fi
    # ────────────────────────────────────────────────────────

    exito_menu "RENOVADO CORRECTAMENTE: $usuario"
    exit 0
fi

# ── Lógica original SSH (intacta) ──────────────────────

database="/root/usuarios.db"

if [ ! -f "$database" ]; then
    fallo_menu "Archivo $database NO encontrado"
    exit 1
fi

# Función para obtener usuario por ID
get_user_by_id() {
    local id="$1"
    local current=1
    while IFS=' ' read -r user limite pass exp resto; do
        if [[ $current -eq $id ]]; then
            echo "$user"
            return
        fi
        current=$((current+1))
    done < "$database"
}

# Listar usuarios con IDs y sus fechas de vencimiento
echo "LISTA DE USUARIOS Y FECHAS DE VENCIMIENTO:"
echo "--------------------------------------------"
echo ""

id=0
while IFS=' ' read -r user limit pass exp resto; do
    [[ -z "$user" ]] && continue

    # Verificar que el usuario existe en el sistema
    if ! grep -q "^$user:" /etc/passwd; then
        continue
    fi

    id=$((id + 1))

    # Obtener fecha de expiración
    expire="$(chage -l "$user" 2>/dev/null | grep -E "Account expires" | cut -d ':' -f2- | sed 's/^[[:space:]]*//')"

    if [[ -z "$expire" ]] || [[ "$expire" == "never" ]]; then
        fecha="00/00/0000"
        estado="SIN FECHA"
    else
        fecha=$(date -d "$expire" '+%d/%m/%Y' 2>/dev/null)
        if [ $? -ne 0 ]; then
            fecha="ERROR"
            estado="ERROR"
        else
            databr=$(date -d "$expire" +"%Y%m%d" 2>/dev/null)
            hoje=$(date -d today +"%Y%m%d")

            if [ "$hoje" -ge "$databr" ]; then
                estado="VENCIDO"
            else
                estado="VALIDO"
            fi
        fi
    fi

    # Formato: [ID] - Usuario | Fecha | Estado
    printf "[%02d] - %-20s | %-10s | %s\n" "$id" "$user" "$fecha" "$estado"
done < "$database"

# Si no hay usuarios
if [[ $id -eq 0 ]]; then
    fallo_menu "No hay usuarios registrados en el sistema."
    exit 1
fi

echo ""
echo "--------------------------------------------"
echo "Total de usuarios: $id"
echo ""

# Seleccionar usuario por ID
echo -n "Seleccione un usuario por ID [1-$id]: "
read option

# Validar entrada
if [[ -z $option ]]; then
    fallo_menu "Debe seleccionar un ID"
    exit 1
fi

# Validar que sea número
if ! [[ "$option" =~ ^[0-9]+$ ]]; then
    fallo_menu "Debe ingresar un número válido"
    exit 1
fi

# Validar rango
if [[ $option -lt 1 ]] || [[ $option -gt $id ]]; then
    fallo_menu "ID fuera de rango [1-$id]"
    exit 1
fi

# Obtener usuario por ID
usuario=$(get_user_by_id "$option")

if [[ -z $usuario ]]; then
    fallo_menu "Usuario no encontrado"
    exit 1
fi

# Verificar que el usuario existe en el sistema
if ! grep -q "^$usuario:" /etc/passwd; then
    fallo_menu "El usuario $usuario no existe en el sistema"
    exit 1
fi

# Mostrar fecha actual
expire_actual="$(chage -l "$usuario" 2>/dev/null | grep -E "Account expires" | cut -d ':' -f2- | sed 's/^[[:space:]]*//')"
if [[ "$expire_actual" == "never" ]] || [[ -z "$expire_actual" ]]; then
    fecha_actual="Sin fecha de vencimiento"
else
    fecha_actual=$(date -d "$expire_actual" '+%d/%m/%Y' 2>/dev/null)
fi

echo ""
echo "Usuario seleccionado: $usuario"
echo "Vencimiento actual: $fecha_actual"
echo ""

# Instrucciones
echo "FORMATOS ACEPTADOS:"
echo "  - Fecha: DD/MM/AAAA (Ejemplo: 21/04/2024)"
echo "  - Dias:  30 (30 dias a partir de hoy)"
echo ""

# Solicitar nueva fecha o días
echo -n "Nueva fecha o dias para el usuario $usuario: "
read inputdate

# Validar entrada
if [[ -z $inputdate ]]; then
    fallo_menu "Debe ingresar una fecha o número de días"
    exit 1
fi

# Determinar si es fecha (contiene /) o días (solo números)
if [[ "$inputdate" =~ "/" ]]; then
    # Es una fecha en formato DD/MM/AAAA
    sysdate="$(echo "$inputdate" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
    udata="$inputdate"
else
    # Son días
    if ! [[ "$inputdate" =~ ^[0-9]+$ ]]; then
        fallo_menu "Debe ingresar un número de días válido"
        exit 1
    fi

    if [[ $inputdate -lt 1 ]]; then
        fallo_menu "Los días deben ser mayor que 0"
        exit 1
    fi

    # Calcular fecha sumando días
    udata=$(date "+%d/%m/%Y" -d "+$inputdate days")
    sysdate="$(echo "$udata" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
fi

# Validar que la fecha es válida
if ! date "+%Y-%m-%d" -d "$sysdate" > /dev/null 2>&1; then
    fallo_menu "Fecha inválida o inexistente. Use DD/MM/AAAA o un número de días."
    exit 1
fi

# Verificar que no sea fecha pasada
today="$(date -d today +"%Y%m%d")"
timemachine="$(date -d "$sysdate" +"%Y%m%d")"

if [ "$today" -gt "$timemachine" ]; then
    fallo_menu "La fecha ingresada es anterior a hoy. Debe ingresar una fecha futura."
    exit 1
fi

# Aplicar nueva fecha de vencimiento
chage -E "$sysdate" "$usuario" 2>/dev/null

if [ $? -eq 0 ]; then
    # Actualizar la fecha en el archivo usuarios.db
    # Buscamos la línea que empieza con el usuario y actualizamos la 4ta columna
    sed -i "/^$usuario /s/^\([^ ]* [^ ]* [^ ]* \)[^ ]*/\1$sysdate/" "$database"

    # ── Desbloqueo automático y eliminación de lista de bloqueados ──
    if grep -qxF "$usuario" "$LOCKED_LIST" 2>/dev/null; then
        if [[ -f "$SENHA_DIR/$usuario" ]]; then
            orig=$(cat "$SENHA_DIR/$usuario" | tr -d '\r')
            echo "$usuario:$orig" | chpasswd 2>/dev/null
        fi
        usermod -U "$usuario" 2>/dev/null
        passwd -u "$usuario" 2>/dev/null
        sed -i "/^$usuario$/d" "$LOCKED_LIST" 2>/dev/null
    fi
    # ────────────────────────────────────────────────────────

    exito_menu "RENOVADO CORRECTAMENTE: $usuario"
    exit 0
else
    fallo_menu "No se pudo actualizar la fecha de vencimiento"
    exit 1
fi
,