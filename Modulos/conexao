# Definir colores y efectos (Eliminados para evitar problemas de compatibilidad)
verde=""
azul=""
cyan=""
rojo=""
blanco=""
amarillo=""
fin=""

ram1=$(free -h | grep -i mem | awk {'print $2'})
ram2=$(free -h | grep -i mem | awk {'print $4'})
ram3=$(free -h | grep -i mem | awk {'print $3'})
uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
system=$(cat /etc/issue.net)

fun_bar() {
	comando[0]="$1"
	comando[1]="$2"
	(
		[[ -e $HOME/fim ]] && rm $HOME/fim
		[[ ! -d /etc/GENSSH ]] && rm -rf /bin/menu
		${comando[0]} >/dev/null 2>&1
		${comando[1]} >/dev/null 2>&1
		touch $HOME/fim
	) >/dev/null 2>&1 &
	tput civis
	echo -ne "AGUARDE - ["
	while true; do
		for ((i = 0; i < 18; i++)); do
			echo -ne "#"
			sleep 0.1s
		done
		[[ -e $HOME/fim ]] && rm $HOME/fim && break
		echo -e "]"
		sleep 1s
		tput cuu1
		tput dl1
		echo -ne "AGUARDE - ["
	done
	echo -e "] - OK !"
	tput cnorm
}

verif_ptrs() {
	porta=$1
	PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
	for pton in $(echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq); do
		svcs=$(echo -e "$PT" | grep -w "$pton" | awk '{print $1}' | uniq)
		[[ "$porta" = "$pton" ]] && {
			echo -e "\nPORTA $porta EM USO PELO $svcs"
			sleep 3
			fun_conexao
		}
	done
}

slow_setup() {
	[[ -e "/bin/slowdns" ]] && {
		slowdns
	} || {
		cd $HOME
		wget https://raw.githubusercontent.com/vpsvip7/GENSSH/main/Slowdns/install -o /dev/null
		chmod 777 install
		./install
	}
}

inst_sqd() {
	if netstat -nltp | grep 'squid' 1>/dev/null 2>/dev/null; then
		echo "            REMOVER SQUID PROXY              "
		echo ""
		echo -ne "REALMENTE DESEA REMOVER EL SQUID ? [s/n]: "
		read resp
		[[ "$resp" = 's' ]] && {
			echo -e "\nREMOVENDO EL SQUID PROXY !"
			echo ""
			rem_sqd() {
				[[ -d "/etc/squid" ]] && {
					apt-get remove squid -y >/dev/null 2>&1
					apt-get purge squid -y >/dev/null 2>&1
					rm -rf /etc/squid >/dev/null 2>&1
				}
				[[ -d "/etc/squid3" ]] && {
					apt-get remove squid3 -y >/dev/null 2>&1
					apt-get purge squid3 -y >/dev/null 2>&1
					rm -rf /etc/squid3 >/dev/null 2>&1
					apt autoremove -y >/dev/null 2>&1
				}
			}
			fun_bar 'rem_sqd'
			echo -e "\nSQUID REMOVIDO CON SUCESSO !"
			sleep 2
			clear
			fun_conexao
		} || {
			echo -e "\nRetornando..."
			sleep 2
			clear
			fun_conexao
		}
	else
		clear
		echo "              INSTALADOR SQUID                "
		echo ""
		IP=$(wget -qO- ipv4.icanhazip.com)
		echo -ne "PARA CONTINUAR CONFIRME SU IP: "
		read -e -i $IP ipdovps
		[[ -z "$ipdovps" ]] && {
			echo -e "\nIP invalido"
			echo ""
			read -p "Digite seu IP: " IP
		}
		echo -e "\nCUAL PUERTO DESEA ULTILIZAR EN SQUID ?"
		echo -e "\n[!] DEFINA LOS PORTOS EN SECUENCIA EX: 80 8080"
		echo ""
		echo -ne "INFORME LOS PORTOS: "
		read portass
		[[ -z "$portass" ]] && {
			echo -e "\nPorta invalida!"
			sleep 3
			fun_conexao
		}
		for porta in $(echo -e $portass); do
			verif_ptrs $porta
		done
		[[ $(grep -wc '14' /etc/issue.net) != '0' ]] || [[ $(grep -wc '8' /etc/issue.net) != '0' ]] && {
			echo -e "\nINSTALANDO SQUID PROXY\n"
			fun_bar 'apt update -y' "apt install squid3 -y"
		} || {
			echo -e "\n[1] • SQUID VERSAO 3.3.X\n[2] • SQUID VERSAO 3.5.X\n"
			read -p "$(echo -e "INFORME UNA OPCION: ")" -e -i 1 opc
			[[ -z "$opc" ]] && {
				echo -e "\nOpcao invalida!"
				sleep 2
				fun_conexao
			}
			[[ "$opc" != '1' ]] && {
				[[ "$opc" != '2' ]] && {
					echo -e "\nOpcao invalida !"
					sleep 2
					fun_conexao
				}
			}
			echo -e "\nINSTALANDO SQUID PROXY\n"
			fun_bar 'apt update -y' "instsqd $opc"
		}
		if [[ -d "/etc/squid/" ]]; then
			var_sqd="/etc/squid/squid.conf"
			var_pay="/etc/squid/payload.txt"
		elif [[ -d "/etc/squid3/" ]]; then
			var_sqd="/etc/squid3/squid.conf"
			var_pay="/etc/squid3/payload.txt"
		else
			echo -e "\n[ERRO]: O SQUID PROXY CORROMPIDO"
			sleep 2
			fun_conexao
		fi
		cat <<-EOF >$var_pay
			.whatsapp.net/
			.facebook.net/
			.twitter.com/
			.speedtest.net/
		EOF
		cat <<-EOF >$var_sqd
			acl url1 dstdomain -i 127.0.0.1
			acl url2 dstdomain -i localhost
			acl url3 dstdomain -i $ipdovps
			acl url4 dstdomain -i /GENSSH?
			acl payload url_regex -i "$var_pay"
			acl all src 0.0.0.0/0

			http_access allow url1
			http_access allow url2
			http_access allow url3
			http_access allow url4
			http_access allow payload
			http_access deny all
			 
			#Portas
		EOF
		for Pts in $(echo -e $portass); do
			echo -e "http_port $Pts" >>$var_sqd
			[[ -f "/usr/sbin/ufw" ]] && ufw allow $Pts/tcp
		done
		cat <<-EOF >>$var_sqd
			#Nome squid
			visible_hostname GENSSH 
			via off
			forwarded_for off
			pipeline_prefetch off
		EOF
		sqd_conf() {
			[[ -d "/etc/squid/" ]] && {
				service ssh restart
				/etc/init.d/squid restart
				service squid restart
			}
			[[ -d "/etc/squid3/" ]] && {
				service ssh restart
				/etc/init.d/squid3 restart
				service squid3 restart
			}
		}
		echo -e "\nCONFIGURANDO SQUID PROXY"
		echo ""
		fun_bar 'sqd_conf'
		echo -e "\nSQUID INSTALADO CON EXITO!"
		sleep 2.5s
		fun_conexao
	fi
}

addpt_sqd() {
	echo "         ADICIONAR PUERTO A SQUID         "
	echo -e "\nPUERTOS EN USO: $sqdp\n"
	if [[ -f "/etc/squid/squid.conf" ]]; then
		var_sqd="/etc/squid/squid.conf"
	elif [[ -f "/etc/squid3/squid.conf" ]]; then
		var_sqd="/etc/squid3/squid.conf"
	else
		echo -e "\nSQUID NO ESTA INSTALADO!"
		echo -e "\nRetornando..."
		sleep 2
		clear
		fun_squid
	fi
	echo -ne "CUAL PUERTO DESEA ADICIONAR ? "
	read pt
	[[ -z "$pt" ]] && {
		echo -e "\nPorta invalida!"
		sleep 2
		clear
		fun_conexao
	}
	verif_ptrs $pt
	echo -e "\nADICIONANDO PUERTO A SQUID!"
	echo ""
	sed -i "s/#Portas/#Portas\nhttp_port $pt/g" $var_sqd
	fun_bar 'sleep 2'
	echo -e "\nREINICIANDO O SQUID!"
	echo ""
	fun_bar 'service squid restart' 'service squid3 restart'
	echo -e "\nPORTA ADICIONADA COM SUCESSO!"
	sleep 3
	clear
	fun_squid
}

rempt_sqd() {
	echo "        REMOVER PORTA DO SQUID        "
	echo -e "\nPORTAS EM USO: $sqdp\n"
	if [[ -f "/etc/squid/squid.conf" ]]; then
		var_sqd="/etc/squid/squid.conf"
	elif [[ -f "/etc/squid3/squid.conf" ]]; then
		var_sqd="/etc/squid3/squid.conf"
	else
		echo -e "\nSQUID NAO ESTA INSTALADO!"
		echo -e "\nRetornando..."
		sleep 2
		clear
		fun_squid
	fi
	echo -ne "QUAL PORTA DESEJA REMOVER ? "
	read pt
	[[ -z "$pt" ]] && {
		echo -e "\nPorta invalida!"
		sleep 2
		clear
		fun_conexao
	}
	if grep -E "$pt" $var_sqd >/dev/null 2>&1; then
		echo -e "\nREMOVENDO PORTA DO SQUID!"
		echo ""
		sed -i "/http_port $pt/d" $var_sqd
		fun_bar 'sleep 3'
		echo -e "\nREINICIANDO O SQUID!"
		echo ""
		fun_bar 'service squid restart' 'service squid3 restart'
		echo -e "\nPORTA REMOVIDA COM SUCESSO!"
		sleep 3.5s
		clear
		fun_squid
	else
		echo -e "\nPORTA $pt NAO ENCONTRADA!"
		sleep 3.5s
		clear
		fun_squid
	fi
}

fun_squid() {
	[[ "$(netstat -nplt | grep -c 'squid')" = "0" ]] && inst_sqd
	echo "          GERENCIAR SQUID PROXY           "
	[[ "$(netstat -nplt | grep -c 'squid')" != "0" ]] && {
		sqdp=$(netstat -nplt | grep 'squid' | awk -F ":" {'print $4'} | xargs)
		echo -e "\nPORTAS: $sqdp"
		VarSqdOn="REMOVER SQUID PROXY"
	} || {
		VarSqdOn="INSTALAR SQUID PROXY"
	}
	echo -e "\n[1] • $VarSqdOn \n[2] • ADICIONAR PORTA \n[3] • REMOVER PORTA\n[0] • VOLTAR"
	echo ""
	echo -ne "OQUE DESEJA FAZER ?? "
	read x
	clear
	case $x in
	1 | 01)
		inst_sqd
		;;
	2 | 02)
		addpt_sqd
		;;
	3 | 03)
		rempt_sqd
		;;
	0 | 00)
		echo -e "Retornando..."
		sleep 1
		fun_conexao
		;;
	*)
		echo -e "Opcao Invalida..."
		sleep 2
		fun_conexao
		;;
	esac
}

fun_drop() {
	if netstat -nltp | grep 'dropbear' 1>/dev/null 2>/dev/null; then
		clear
		[[ $(netstat -nltp | grep -c 'dropbear') != '0' ]] && dpbr=$(netstat -nplt | grep 'dropbear' | awk -F ":" {'print $4'} | xargs) || sqdp="INDISPONIVEL"
		if ps x | grep "limiter" | grep -v grep 1>/dev/null 2>/dev/null; then
			stats='◉ '
		else
			stats='○ '
		fi
		echo "              MENU DROPBEAR               "
		echo -e "\nPORTAS: $dpbr"
		echo ""
		echo -e "[1] • LIMITER DROPBEAR $stats"
		echo -e "[2] • EDITAR PUERTO DROPBEAR"
		echo -e "[3] • REMOVER DROPBEAR"
		echo -e "[0] • VOLVER"
		echo ""
		echo -ne " QUE DESEA HACER ? "
		read resposta
		if [[ "$resposta" = '1' ]]; then
			clear
			if ps x | grep "limiter" | grep -v grep 1>/dev/null 2>/dev/null; then
				echo -e "Parando o limiter... "
				echo ""
				fun_stplimiter() {
					pidlimiter=$(ps x | grep "limiter" | awk -F "pts" {'print $1'})
					kill -9 $pidlimiter
					screen -wipe
				}
				fun_bar 'fun_stplimiter' 'sleep 2'
				echo -e "\n LIMITER DESACTIVADO "
				sleep 3
				fun_drop
			else
				echo -e "\nIniciando o limiter... "
				echo ""
				fun_bar 'screen -d -m -t limiter droplimiter' 'sleep 3'
				echo -e "\n  LIMITER ACTIVADO "
				sleep 3
				fun_drop
			fi
		elif [[ "$resposta" = '2' ]]; then
			echo ""
			echo -ne " CUAL PUERTO DESEA ULTILIZAR ? "
			read pt
			echo ""
			verif_ptrs $pt
			var1=$(grep 'DROPBEAR_PORT=' /etc/default/dropbear | cut -d'=' -f2)
			echo -e "ALTERANDO PORTA DROPBEAR!"
			sed -i "s/\b$var1\b/$pt/g" /etc/default/dropbear >/dev/null 2>&1
			echo ""
			fun_bar 'sleep 2'
			echo -e "\nREINICIANDO DROPBEAR!"
			echo ""
			fun_bar 'service dropbear restart' '/etc/init.d/dropbear restart'
			echo -e "\nPUERTO ALTERADO OK!"
			sleep 3
			clear
			fun_conexao
		elif [[ "$resposta" = '3' ]]; then
			echo -e "\nREMOVENDO EL DROPBEAR !"
			echo ""
			fun_dropunistall() {
				service dropbear stop && /etc/init.d/dropbear stop
				apt-get autoremove dropbear -y
				apt-get remove dropbear-run -y
				apt-get remove dropbear -y
				apt-get purge dropbear -y
				rm -rf /etc/default/dropbear
			}
			fun_bar 'fun_dropunistall'
			echo -e "\nDROPBEAR REMOVIDO CON EXITO !"
			sleep 3
			clear
			fun_conexao
		elif [[ "$resposta" = '0' ]]; then
			echo -e "\nRetornando..."
			sleep 2
			fun_conexao
		else
			echo -e "\nOpcao invalida..."
			sleep 2
			fun_conexao
		fi
	else
		clear
		echo "           INSTALADOR DROPBEAR              "
		echo -e "\nWEP ESTAS POR  INSTALAR EL DROPBEAR !\n"
		echo -ne "DESEA CONTINUAR ? [s/n]: "
		read resposta
		[[ "$resposta" = 's' ]] && {
			echo -e "\nDEFINA UN PORTO PARA  DROPBEAR !\n"
			echo -ne "CUAL  PUERTO ? "
			read porta
			[[ -z "$porta" ]] && {
				echo -e "\nPorta invalida!"
				sleep 3
				clear
				fun_conexao
			}
			verif_ptrs $porta
			echo -e "\nINSTALANDO EL DROPBEAR ! "
			echo ""
			fun_instdrop() {
				apt-get update -y
				apt-get install dropbear -y
			}
			fun_bar 'fun_instdrop'
			fun_ports() {
				sed -i 's/NO_START=1/NO_START=0/g' /etc/default/dropbear >/dev/null 2>&1
				sed -i "s/DROPBEAR_PORT=22/DROPBEAR_PORT=$porta/g" /etc/default/dropbear >/dev/null 2>&1
				sed -i 's/DROPBEAR_EXTRA_ARGS=/DROPBEAR_EXTRA_ARGS="-p 110"/g' /etc/default/dropbear >/dev/null 2>&1
			}
			echo ""
			echo -e "CONFIGURANDO PUERTO DROPBEAR !"
			echo ""
			fun_bar 'fun_ports'
			grep -v "^PasswordAuthentication yes" /etc/ssh/sshd_config >/tmp/passlogin && mv /tmp/passlogin /etc/ssh/sshd_config
			echo "PasswordAuthentication yes" >>/etc/ssh/sshd_config
			grep -v "^PermitTunnel yes" /etc/ssh/sshd_config >/tmp/ssh && mv /tmp/ssh /etc/ssh/sshd_config
			echo "PermitTunnel yes" >>/etc/ssh/sshd_config
			echo ""
			echo -e "FINALIZANDO INSTALACION !"
			echo ""
			fun_ondrop() {
				service dropbear start
				/etc/init.d/dropbear restart
			}
			fun_bar 'fun_ondrop' 'sleep 1'
			echo -e "\nINSTALACION CONCLUIDA PORTA: $porta"
			[[ $(grep -c "/bin/false" /etc/shells) = '0' ]] && echo "/bin/false" >>/etc/shells
			sleep 2
			clear
			fun_conexao
		} || {
			echo ""
			echo -e "Retornando..."
			sleep 3
			clear
			fun_conexao
		}
	fi
}

