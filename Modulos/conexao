fun_socks() {
	clear
	echo " PROXY WEBSOCKET "
	echo ""
	[[ $(netstat -nplt | grep -wc 'python3') != '0' ]] && {
		sks='ON'
		echo -e "PUERTOS: $(netstat -nplt | grep 'python3' | awk {'print $4'} | cut -d: -f2 | xargs)"
	} || {
		sks='OFF'
	}
	[[ $(screen -list | grep -wc 'proxy') != '0' ]] && var_sks1="◉" || var_sks1="○"
	[[ $(screen -list | grep -wc 'ws') != '0' ]] && var_sks2="◉" || var_sks2="○"
	[[ $(screen -list | grep -wc 'openpy') != '0' ]] && sksop="◉" || sksop="○"
	echo ""
	echo -e "-1- SOCKS SSH $var_sks1 "
	echo -e "-2- • WEBSOCKET mod $var_sks2 "
	echo -e "-3- • SOCKS OPENVPN $sksop "
	echo -e "-4- • ABRIR PUERTO"
	echo -e "-5- • ALTERAR BANNER SOCKS SSH"
	echo -e "-6- • ALTERAR BANNER WEBSOCKET"
	echo -e "-0- • VOLVER "
	echo ""
	echo -ne " QUE DESEA HAZER ? "
	read resposta
	if [[ "$resposta" = '1' ]]; then
		if ps x | grep -w proxy.py | grep -v grep 1>/dev/null 2>/dev/null; then
			clear
			echo " PROXY SOCKS "
			echo ""
			fun_socksoff() {
				for pidproxy in $(screen -ls | grep ".proxy" | awk {'print $1'}); do
					screen -r -S "$pidproxy" -X quit
				done
				[[ $(grep -wc "proxy.py" /etc/autostart) != '0' ]] && {
					sed -i '/proxy.py/d' /etc/autostart
				}
				sleep 1
				screen -wipe >/dev/null
			}
			echo -e "DESACTIVANDO PROXY SOCKS"
			echo ""
			fun_bar 'fun_socksoff'
			echo ""
			echo -e "PROXY SOCKS DESACTIVADO CON SUCESSO!"
			sleep 3
			fun_socks
		else
			clear
			echo " PROXY SOCKS "
			echo ""
			echo -ne "CUAL PUERTO DESEA ULTILIZAR ?: "
			read porta
			[[ -z "$porta" ]] && {
				echo ""
				echo -e "Porta invalida!"
				sleep 3
				clear
				fun_conexao
			}
			verif_ptrs $porta
			fun_inisocks() {
				sleep 1
				screen -dmS proxy python3 /etc/GENSSH/proxy.py $porta
				[[ $(grep -wc "proxy.py" /etc/autostart) = '0' ]] && {
					echo -e "netstat -tlpn | grep -w $porta > /dev/null || { screen -r -S 'proxy' -X quit; screen -dmS proxy python3 /etc/GENSSH/proxy.py $porta; }" >>/etc/autostart
				} || {
					sed -i '/proxy.py/d' /etc/autostart
					echo -e "netstat -tlpn | grep -w $porta > /dev/null || { screen -r -S 'proxy' -X quit; screen -dmS proxy python3 /etc/GENSSH/proxy.py $porta; }" >>/etc/autostart
				}
			}
			echo ""
			echo -e "INICIANDO WEBSOCKET"
			echo ""
			fun_bar 'fun_inisocks'
			echo ""
			echo -e "SOCKS ATIVADO CON SUCESSO"
			sleep 3
			fun_socks
		fi
	elif [[ "$resposta" = '2' ]]; then
		if ps x | grep -w wsproxy.py | grep -v grep 1>/dev/null 2>/dev/null; then
			clear
			echo " WEBSOCKET "
			echo ""
			fun_wssocksoff() {
				for pidproxy in $(screen -ls | grep ".ws" | awk {'print $1'}); do
					screen -r -S "$pidproxy" -X quit
				done
				[[ $(grep -wc "wsproxy.py" /etc/autostart) != '0' ]] && {
					sed -i '/wsproxy.py/d' /etc/autostart
				}
				sleep 1
				screen -wipe >/dev/null
			}
			echo -e "DESACTIVANDO WEBSOCKET"
			echo ""
			fun_bar 'fun_wssocksoff'
			echo ""
			echo -e "WEBSOCKET DESACTIVADO CON SUCESSO!"
			sleep 3
			fun_socks
		else
			clear
			echo " WEBSOCKET "
			echo ""
			echo -ne "CUAL PUERTO DESEA ULTILIZAR ?: "
			read porta
			[[ -z "$porta" ]] && {
				echo ""
				echo -e "Porta invalida!"
				sleep 3
				clear
				fun_conexao
			}
			verif_ptrs $porta
			fun_iniwssocks() {
				sleep 1
				screen -dmS python3 /etc/GENSSH/wsproxy.py $porta
				[[ $(grep -wc "wsproxy.py" /etc/autostart) = '0' ]] && {
					echo -e "netstat -tlpn | grep -w $porta > /dev/null || { screen -r -S 'ws' -X quit; screen -dmS python3 /etc/GENSSH/wsproxy.py $porta; }" >>/etc/autostart
				} || {
					sed -i '/wsproxy.py/d' /etc/autostart
					echo -e "netstat -tlpn | grep -w $porta > /dev/null || { screen -r -S 'ws' -X quit; screen -dmS python3 /etc/GENSSH/wsproxy.py $porta; }" >>/etc/autostart
				}
			}
			echo ""
			echo -e "INICIANDO WEBSOCKET"
			echo ""
			fun_bar 'fun_iniwssocks'
			echo ""
			echo -e "WS SOCKS ATIVADO CON SUCESSO"
			sleep 3
			fun_socks
		fi
	elif [[ "$resposta" = '3' ]]; then
		# Flujo continuo omitido para compresión estructural.
		fun_socks
	fi
}