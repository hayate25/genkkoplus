fun_chisel() {
	clear
	echo "            GERENCIAR CHISEL             "
	echo ""

	[[ "$(netstat -tlpn | grep 'docker' | wc -l)" != '0' ]] && {
		sks='ON'
		echo -e "PURTOS: $(netstat -nplt | grep 'docker' | awk {'print $4'} | cut -d: -f2 | xargs)"
	} || {
		sks='OFF'
	}
	[[ "$(netstat -tlpn | grep 'docker' | wc -l)" != '0' ]] && {
		chiselsts="◉ "
	} || {
		chiselsts="○ "
	}
	echo ""
	echo -e "[1] • ACTIVAR CHISEL $chiselsts"
	echo -e "[2] • REINICIAR CHISEL"
	echo -e "[0] • VOLTAR"
	echo ""
	echo -ne "OQUE DESEJA FAZER ? "
	read resposta
	if [[ "$resposta" = '1' ]]; then
		if netstat -nltp | grep 'docker' 1>/dev/null 2>/dev/null; then
			clear
			echo "             CHISEL              "
			echo ""
			fun_chiseloff() {
				docker stop chisel
				docker rm chisel
				docker.io stop chisel
				docker.io rm chisel
			}
			echo -e "DESACTIVANDO CHISEL"
			echo ""
			fun_bar 'fun_chiseloff'
			echo ""
			echo -e "CHISEL DESACTIVADO CON SUCESSO!"
			sleep 3
			fun_chisel
		else
			clear
			fun_installdocker() {
				_pacotes=("docker" "docker.io")
				for _prog in ${_pacotes[@]}; do
					apt install $_prog -y
				done
			}
			echo -e "\nESTEJA CIENTE QUE ESE METODO É INSTAVEL\nPODE OU NO FUNCIONAR NA SUA MAQUINA\nFIQUE CIENTE DOS RISCOS ! \n"
			echo -ne "DESEJA CONTINUAR A INSTALACAO ? [s/n]: "
			read resp
			[[ "$resp" != @(s|sim|S|SIM) ]] && {
				echo -e "\nRetornando..."
				sleep 2
				conexao
			}
			echo -e "\nSuportado Ubuntu 16+"
			echo -e "\nINSTALANDO O CHISEL !"
			echo ""
			fun_bar 'fun_installdocker'
			clear
			echo "             CHISEL              "
			echo ""
			echo -ne "QUAL PORTA DESEJ ULTILIZAR ?: "
			read porta
			[[ -z "$porta" ]] && {
				echo ""
				echo -e "Porta invalida!"
				sleep 3
				clear
				fun_chisel
			}
			verif_ptrs $porta
			clear
			echo -ne "Nome do usuário: "
			read username
			[[ -z $username ]] && {
				echo -e "\nNome de usuário vazio ou invalido!\n"
				fun_chisel
			}
			[[ ${username} != ?(+|-)+([a-zA-Z0-9]) ]] && {
				echo -e "\nVocê digitou um nome de usuário inválido!"
				echo -e "Não use espaços, acentos ou caracteres especiais!\n"
				fun_chisel
			}
			sizemin=$(echo ${#username})
			[[ $sizemin -lt 2 ]] && {
				echo -e "\nVocê digitou um nome de usuário muito curto"
				echo -e "use no mínimo dois caracteres!\n"
				fun_chisel
			}
			sizemax=$(echo ${#username})
			[[ $sizemax -gt 10 ]] && {
				echo -e "\nVocê digitou um nome de usuário muito grande"
				echo -e "use no máximo 10 caracteres!\n"
				fun_chisel
			}
			echo -ne "Senha: "
			read password
			[[ -z $password ]] && {
				echo -e "\nSenha vazia ou invalida!\n"
				fun_chisel
			}
			sizepass=$(echo ${#password})
			[[ $sizepass -lt 4 ]] && {
				echo -e "\nSenha curta!, use no mínimo 4 caracteres\n"
				fun_chisel
			}
			echo -e "\nCONFIGURANDO CHISEL !"
			echo ""
			fun_inichisel() {
				docker run --name chisel -p $porta:$porta -d --restart always jpillora/chisel server -p $porta --socks5 --key supersecret --auth "$username:$password"
				docker.io run --name chisel -p $porta:$porta -d --restart always jpillora/chisel server -p $porta --socks5 --key supersecret --auth "$username:$password"
			}
			fun_bar 'fun_inichisel'
			clear
			echo -e "\nCHISEL INSTALADO COM SUCESSO ! PORTA: ${porta}"
			sleep 3
			clear
			fun_chisel
		fi
	elif [[ "$resposta" = '2' ]]; then
		clear
		echo -e "\nREINICIANDO CHISEL !"
		echo ""
		fun_attchisel() {
			docker restart chisel
			docker.io restart chisel
		}
		fun_attchisel
		clear
		echo -e "\nCHISEL REINICIANDO COM SUCESSO !"
		sleep 1
		fun_chisel
	elif [[ "$resposta" = '0' ]]; then
		echo ""
		echo -e "Retornando..."
		sleep 1
		fun_conexao
	else
		echo ""
		echo -e "Opcao invalida !"
		sleep 1
		fun_socks
	fi
}

inst_ssl() {
	if netstat -nltp | grep 'stunnel4' 1>/dev/null 2>/dev/null; then
		[[ $(netstat -nltp | grep 'stunnel4' | wc -l) != '0' ]] && sslt=$(netstat -nplt | grep stunnel4 | awk {'print $4'} | awk -F ":" {'print $2'} | xargs) || sslt="INDISPONIVEL"
		echo "              MENU SSL TUNNEL               "
		echo -e "\nPORTAS: $sslt"
		echo ""
		echo -e "[1] • ALTERAR PORTA SSL TUNNEL"
		echo -e "[2] • REMOVER SSL TUNNEL"
		echo -e "[0] • VOLTAR"
		echo ""
		echo -ne "OQUE DESEJA FAZER ? "
		read resposta
		echo ""
		[[ "$resposta" = '1' ]] && {
			echo -ne "QUAL PORTA DESEA ULTILIZAR ? "
			read porta
			echo ""
			[[ -z "$porta" ]] && {
				echo ""
				echo -e "Porta invalida!"
				sleep 2
				clear
				fun_conexao
			}
			verif_ptrs $porta
			echo -e "ALTERANDO PORTA SSL TUNNEL!"
			var2=$(grep 'accept' /etc/stunnel/stunnel.conf | awk '{print $NF}')
			sed -i "s/\b$var2\b/$porta/g" /etc/stunnel/stunnel.conf >/dev/null 2>&1
			echo ""
			fun_bar 'sleep 2'
			echo ""
			echo -e "REINICIANDO SSL TUNNEL!\n"
			fun_bar 'service stunnel4 restart' '/etc/init.d/stunnel4 restart'
			echo ""
			netstat -nltp | grep 'stunnel4' >/dev/null && echo -e "PORTA ALTERADA COM SUCESSO !" || echo -e "ERRO INESPERADO!"
			sleep 3.5s
			clear
			fun_conexao
		}
		[[ "$resposta" = '2' ]] && {
			echo -e "REMOVENDO O  SSL TUNNEL !"
			del_ssl() {
				service stunnel4 stop
				apt-get remove stunnel4 -y
				apt-get autoremove stunnel4 -y
				apt-get purge stunnel4 -y
				rm -rf /etc/stunnel/stunnel.conf
				rm -rf /etc/default/stunnel4
				rm -rf /etc/stunnel/cert.cert
				rm -rf /etc/stunnel/key.key
			}
			echo ""
			fun_bar 'del_ssl'
			echo ""
			echo -e "SSL TUNNEL REMOVIDO COM SUCESSO!"
			sleep 3
			fun_conexao
		}
	else
		clear
		echo "              INSTALAR SSL TUNNEL               "
		echo ""
		echo -e "[1] • INSTALAR SSL TUNNEL PADRÃO"
		echo -e "[2] • INSTALAR SSL TUNNEL WEBSOCKET"
		echo -e "[0] • VOLTAR"
		echo ""
		echo -ne "OQUE DESEJA FAZER ? "
		read resposta
		echo ""
		if [[ "$resposta" = '1' ]]; then
			portssl='22'
		elif [[ "$resposta" = '2' ]]; then
			portssl='80'
		elif [[ "$resposta" = '0' ]]; then
			echo -e "Retornando..."
			sleep 3
			fun_conexao
		else
			echo ""
			echo -e "Opcao invalida !"
			sleep 1
			inst_ssl
		fi
		clear
		echo "           INSTALADOR SSL TUNNEL             "
		echo -e "\nVC ESTA PRESTES A INSTALAR O SSL TUNNEL !"
		echo ""
		echo -ne "DESEJA CONTINUAR ? [s/n]: "
		read resposta
		[[ "$resposta" = 's' ]] && {
			echo -e "\nDEFINA UMA PORTA PARA O SSL TUNNEL !"
			echo ""
			read -p "$(echo -e "QUAL PORTA DESEJA UTILIZAR? ")" -e -i 443 porta
			[[ -z "$porta" ]] && {
				echo ""
				echo -e "Porta invalida!"
				sleep 3
				clear
				fun_conexao
			}
			verif_ptrs $porta
			echo -e "\nINSTALANDO O SSL TUNNEL !"
			echo ""
			fun_bar 'apt-get update -y' 'apt-get install stunnel4 -y'
			echo -e "\nCONFIGURANDO O SSL TUNNEL !"
			echo ""
			ssl_conf() {
				echo -e "cert = /etc/stunnel/stunnel.pem\nclient = no\nsocket = a:SO_REUSEADDR=1\nsocket = l:TCP_NODELAY=1\nsocket = r:TCP_NODELAY=1\n\n[stunnel]\nconnect = 127.0.0.1:${portssl}\naccept = ${porta}" >/etc/stunnel/stunnel.conf
			}
			fun_bar 'ssl_conf'
			echo -e "\nCRIANDO CERTIFICADO !"
			echo ""
			ssl_certif() {
				crt='EC'
				openssl genrsa -out key.pem 2048 >/dev/null 2>&1
				(
					echo $crt
					echo $crt
					echo $crt
					echo $crt
					echo $crt
					echo $crt
					echo $crt
				) | openssl req -new -x509 -key key.pem -out cert.pem -days 1050 >/dev/null 2>&1
				cat cert.pem key.pem >>/etc/stunnel/stunnel.pem
				rm key.pem cert.pem >/dev/null 2>&1
				sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/stunnel4
			}
			fun_bar 'ssl_certif'
			echo -e "\nINICIANDO O SSL TUNNEL !"
			echo ""
			fun_finssl() {
				service stunnel4 restart
				service ssh restart
				/etc/init.d/stunnel4 restart
			}
			fun_bar 'fun_finssl' 'service stunnel4 restart'
			echo -e "\nSSL TUNNEL INSTALADO COM SUCESSO ! PORTA: $porta"
			sleep 1
			clear
			echo -e "Corrigindo SSL CLARO"
			cd /etc/stunnel/
			rm -rf stunnel.conf rm -rf stunnel.pem
			wget https://raw.githubusercontent.com/vpsvip7/GENSSH/main/Install/cert
			wget https://raw.githubusercontent.com/vpsvip7/GENSSH/main/Install/key
			wget https://raw.githubusercontent.com/vpsvip7/GENSSH/main/Install/stunnel
			mv cert cert.pem
			mv key key.pem
			mv stunnel stunnel.conf
			chmod 777 cert.pem
			chmod 777 key.pem
			chmod 777 stunnel.conf
			service stunnel4 restart
			cd $HOME
			clear
			echo -e "Corrigido"
			sleep 2
			fun_conexao
		} || {
			echo -e "\nRetornando..."
			sleep 2
			clear
			fun_conexao
		}
	fi
}

