#!/bin/bash
# GENKKOSSH - BLOQUEADOR TOTAL UNIFICADO Y CORREGIDO (FINAL)
export LC_ALL=C

DB_SSH="/root/usuarios.db"
DB_HWID="/etc/SSHPlus/hwid.db"
DB_TOKEN="/etc/SSHPlus/token.db"
LOCKED_LIST="/etc/SSHPlus/locked_users.db"
SENHA_DIR="/etc/SSHPlus/senha"
MODO_ACTUAL="/etc/SSHPlus/modo_actual.cfg"
AUTH_LOG="/var/log/auth.log"
EXPIRE_CFG="/etc/SSHPlus/expire_time.cfg"
EXPIRE_USER_CFG="/etc/SSHPlus/expire_users.cfg"

DEBUG_LOG="/tmp/debug_bloquear.log"

mkdir -p /etc/SSHPlus
mkdir -p "$SENHA_DIR"
touch "$LOCKED_LIST"

if [ ! -f "$EXPIRE_CFG" ]; then
    echo "23:59" > "$EXPIRE_CFG"
fi

if [ -f "$MODO_ACTUAL" ]; then
    modo=$(cat "$MODO_ACTUAL" | tr -d '\r')
else
    modo="SSH"
fi

get_expire_time() {
    local user=$(echo "$1" | tr -d '\r')
    local hora_usuario=""
    if [[ -f "$EXPIRE_USER_CFG" ]]; then
        hora_usuario=$(grep -m1 "^$user " "$EXPIRE_USER_CFG" 2>/dev/null | awk '{print $2}' | tr -d '\r')
    fi
    if [[ -n "$hora_usuario" ]]; then
        echo "$hora_usuario"
    else
        cat "$EXPIRE_CFG" 2>/dev/null | tr -d '\r' || echo "23:59"
    fi
}

matar_conexiones() {
    local target=$(echo "$1" | tr -d '\r')
    [[ -z "$target" ]] && return
    
    # 1. Rastrear en auth.log para encontrar PIDs de dropbear/sshd
    # Corregido el regex de grep para evitar errores de escape
    local pids=$(grep "Password auth succeeded for '$target'" "$AUTH_LOG" 2>/dev/null | grep -oP '(dropbear|sshd)\[\K[0-9]+' | sort -u)
    
    if [[ -n "$pids" ]]; then
        for pid in $pids; do
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null
            fi
        done
    fi

    # 2. Matar por UID si existe como usuario de sistema
    pkill -9 -u "$target" 2>/dev/null
    
    # 3. Matar por texto en procesos (WS-EPRO, etc)
    ps aux | grep -i "$target" | grep -v grep | awk '{print $2}' | xargs kill -9 2>/dev/null
    
    # 4. Pkill final
    pkill -9 -f "$target" 2>/dev/null
}

bloquear_usuario() {
    local target=$(echo "$1" | tr -d '\r')
    [[ -z "$target" ]] && return
    
    matar_conexiones "$target"
    
    if grep -qxF "$target" "$LOCKED_LIST" 2>/dev/null; then
        return
    fi

    if id "$target" &>/dev/null; then
        local new_pass="BLK_$(date +%s | tail -c 5)"
        echo "$target:$new_pass" | chpasswd 2>/dev/null
        passwd -l "$target" 2>/dev/null
        usermod -L -e 1970-01-01 "$target" 2>/dev/null
        chage -E 0 "$target" 2>/dev/null
    fi

    echo "$target" >> "$LOCKED_LIST"
}

desbloquear_usuario() {
    local target=$(echo "$1" | tr -d '\r')
    if ! grep -qxF "$target" "$LOCKED_LIST" 2>/dev/null; then
        echo "  $target NO ESTA BLOQUEADO"
        return
    fi

    if id "$target" &>/dev/null; then
        passwd -u "$target" 2>/dev/null
        usermod -U -e "" "$target" 2>/dev/null
        chage -E -1 "$target" 2>/dev/null
        if [[ -f "$SENHA_DIR/$target" ]]; then
            local orig=$(cat "$SENHA_DIR/$target" | tr -d '\r')
            echo "$target:$orig" | chpasswd 2>/dev/null
        fi
    fi

    sed -i "/^$target$/d" "$LOCKED_LIST" 2>/dev/null
    echo "  OK: $target DESBLOQUEADO"
}

listar_usuarios() {
    echo "=========================================="
    echo "  USUARIOS - MODO: $modo"
    echo "=========================================="
    case "$modo" in
        SSH)
            echo "  ID | USUARIO | LIM | ESTADO | EXPIRACION"
            echo "  ---|---------|-----|--------|------------"
            local id=1
            while IFS=' ' read -r user limite pass exp_date_db; do
                user=$(echo "$user" | tr -d '\r')
                limite=$(echo "$limite" | tr -d '\r')
                exp_date_db=$(echo "$exp_date_db" | tr -d '\r')
                [[ -z "$user" ]] && continue
                local estado="ACTIVO"
                grep -qxF "$user" "$LOCKED_LIST" 2>/dev/null && estado="BLOQUEADO"
                printf "  %2d | %-7s | %3s | %-6s | %s\n" "$id" "$user" "$limite" "$estado" "$exp_date_db"
                id=$((id+1))
            done < "$DB_SSH" 2>/dev/null
            ;;
        HWID)
            echo "  ID | NOMBRE | HWID | ESTADO"
            echo "  ---|--------|------|----------"
            local id=1
            while IFS='|' read -r nombre hwid exp; do
                nombre=$(echo "$nombre" | tr -d '\r')
                hwid=$(echo "$hwid" | tr -d '\r')
                [[ -z "$nombre" ]] && continue
                local estado="ACTIVO"
                grep -qxF "$hwid" "$LOCKED_LIST" 2>/dev/null && estado="BLOQUEADO"
                printf "  %2d | %-7s | %-16s... | %s\n" "$id" "$nombre" "${hwid:0:16}" "$estado"
                id=$((id+1))
            done < "$DB_HWID" 2>/dev/null
            ;;
        TOKEN)
            echo "  ID | NOMBRE | TOKEN | ESTADO"
            echo "  ---|--------|-------|----------"
            local id=1
            while IFS='|' read -r nombre token pass exp; do
                nombre=$(echo "$nombre" | tr -d '\r')
                [[ -z "$nombre" ]] && continue
                local estado="ACTIVO"
                grep -qxF "$nombre" "$LOCKED_LIST" 2>/dev/null && estado="BLOQUEADO"
                printf "  %2d | %-7s | %-16s... | %s\n" "$id" "$nombre" "${token:0:16}" "$estado"
                id=$((id+1))
            done < "$DB_TOKEN" 2>/dev/null
            ;;
    esac
    echo "=========================================="
}

get_user_by_id() {
    local id="$1"
    local current=1
    case "$modo" in
        SSH)
            while IFS=' ' read -r user limite pass exp_date_db; do
                user=$(echo "$user" | tr -d '\r')
                [[ -z "$user" ]] && continue
                [[ $current -eq $id ]] && echo "$user" && return
                current=$((current+1))
            done < "$DB_SSH" 2>/dev/null
            ;;
        HWID)
            while IFS='|' read -r nombre hwid exp; do
                hwid=$(echo "$hwid" | tr -d '\r')
                [[ -z "$hwid" ]] && continue
                [[ $current -eq $id ]] && echo "$hwid" && return
                current=$((current+1))
            done < "$DB_HWID" 2>/dev/null
            ;;
        TOKEN)
            while IFS='|' read -r nombre token pass exp; do
                nombre=$(echo "$nombre" | tr -d '\r')
                [[ -z "$nombre" ]] && continue
                [[ $current -eq $id ]] && echo "$nombre" && return
                current=$((current+1))
            done < "$DB_TOKEN" 2>/dev/null
            ;;
    esac
    echo ""
}

# Nueva función para obtener el NOMBRE visible a partir del ID
get_name_by_id() {
    local id="$1"
    local current=1
    case "$modo" in
        SSH)
            while IFS=' ' read -r user limite pass exp_date_db; do
                user=$(echo "$user" | tr -d '\r')
                [[ -z "$user" ]] && continue
                [[ $current -eq $id ]] && echo "$user" && return
                current=$((current+1))
            done < "$DB_SSH" 2>/dev/null
            ;;
        HWID)
            while IFS='|' read -r nombre hwid exp; do
                nombre=$(echo "$nombre" | tr -d '\r')
                [[ -z "$nombre" ]] && continue
                [[ $current -eq $id ]] && echo "$nombre" && return
                current=$((current+1))
            done < "$DB_HWID" 2>/dev/null
            ;;
        TOKEN)
            while IFS='|' read -r nombre token pass exp; do
                nombre=$(echo "$nombre" | tr -d '\r')
                [[ -z "$nombre" ]] && continue
                [[ $current -eq $id ]] && echo "$nombre" && return
                current=$((current+1))
            done < "$DB_TOKEN" 2>/dev/null
            ;;
    esac
    echo ""
}

auto_expire() {
    local hoy=$(date +%Y-%m-%d)
    local ahora_min=$(date +%H%M)

    if [[ -f "$DB_SSH" ]]; then
        while IFS=' ' read -r user limite pass exp_date_db; do
            user=$(echo "$user" | tr -d '\r')
            exp_date_db=$(echo "$exp_date_db" | tr -d '\r')
            [[ -z "$user" ]] && continue

            local exp_fmt=""
            exp_chage=$(chage -l "$user" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
            if [[ -n "$exp_chage" && "$exp_chage" != "never" ]]; then
                exp_fmt=$(date -d "$exp_chage" +%Y-%m-%d 2>/dev/null)
            fi

            if [[ -z "$exp_fmt" && -n "$exp_date_db" ]]; then
                exp_fmt=$(date -d "$exp_date_db" +%Y-%m-%d 2>/dev/null)
            fi

            [[ -z "$exp_fmt" ]] && continue

            # Forzar interpretacion decimal con 10#
            local hora_bloqueo=$(get_expire_time "$user" | tr -d ':')
            if [[ "$exp_fmt" < "$hoy" ]] || [[ "$exp_fmt" == "$hoy" && 10#"$ahora_min" -ge 10#"$hora_bloqueo" ]]; then
                echo "[DEBUG SSH] BLOQUEANDO SSH: $user (Exp: $exp_fmt)" >> "$DEBUG_LOG"
                bloquear_usuario "$user"
            else
                echo "[DEBUG SSH] NO BLOQUEADO SSH: $user (Exp: $exp_fmt, Hoy: $hoy)" >> "$DEBUG_LOG"
            fi
        done < "$DB_SSH"
    fi

    if [[ -f "$DB_HWID" ]]; then
        while IFS='|' read -r nombre hwid exp; do
            nombre=$(echo "$nombre" | tr -d '\r')
            hwid=$(echo "$hwid" | tr -d '\r')
            exp=$(echo "$exp" | tr -d '\r')
            [[ -z "$hwid" || -z "$exp" ]] && continue
            local hora_bloqueo=$(get_expire_time "$nombre" | tr -d ':')
            if [[ "$exp" < "$hoy" ]] || [[ "$exp" == "$hoy" && 10#"$ahora_min" -ge 10#"$hora_bloqueo" ]]; then
                bloquear_usuario "$hwid"
            fi
        done < "$DB_HWID"
    fi

    if [[ -f "$DB_TOKEN" ]]; then
        while IFS='|' read -r nombre token pass exp; do
            nombre=$(echo "$nombre" | tr -d '\r')
            exp=$(echo "$exp" | tr -d '\r')
            [[ -z "$nombre" || -z "$exp" ]] && continue
            local hora_bloqueo=$(get_expire_time "$nombre" | tr -d ':')
            if [[ "$exp" < "$hoy" ]] || [[ "$exp" == "$hoy" && 10#"$ahora_min" -ge 10#"$hora_bloqueo" ]]; then
                bloquear_usuario "$nombre"
            fi
        done < "$DB_TOKEN"
    fi
}

if [[ "$1" == "--auto-expire" ]]; then
    auto_expire
    exit 0
fi

while true; do
    clear
    echo "=========================================="
    echo "  BLOQUEAR / DESBLOQUEAR USUARIOS"
    echo "  Hora global: $(cat "$EXPIRE_CFG" 2>/dev/null || echo "23:59")"
    echo "=========================================="
    listar_usuarios
    echo ""
    echo "  [1] Bloquear usuario por ID"
    echo "  [2] Desbloquear usuario por ID"
    echo "  [3] Configurar hora global"
    echo "  [4] Configurar hora por usuario"
    echo "  [0] Volver"
    echo "=========================================="
    echo -n "  Opcion: "; read opt
    case $opt in
        1) echo -n "  ID: "; read id
           u=$(get_user_by_id "$id")
           nombre=$(get_name_by_id "$id")
           if [[ -n "$u" ]]; then 
               bloquear_usuario "$u"
               clear
               echo "BLOQUEADO: $nombre"
               read -t 30 -p "Presione ENTER para continuar..." || true
           fi
           continue
           ;;
        2) echo -n "  ID: "; read id
           u=$(get_user_by_id "$id")
           nombre=$(get_name_by_id "$id")
           if [[ -n "$u" ]]; then 
               desbloquear_usuario "$u"
               clear
               echo "DESBLOQUEADO: $nombre"
               read -t 30 -p "Presione ENTER para continuar..." || true
           fi
           continue
           ;;
        3) configurar_hora_global;;
        4) configurar_hora_usuario;;
        0) exit 0;;
    esac
    read -p "  ENTER para continuar..."
done