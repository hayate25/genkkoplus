cat > /root/sshplus-mirror/Install/install.sh << 'EOF'
#!/bin/bash
clear

[[ "$(whoami)" != "root" ]] && {
    echo "ERROR: Debes ejecutar como root"
    exit 0
}

cd $HOME

echo "=============================================="
echo ""
echo "  ██████╗ ███████╗███╗   ██╗██╗  ██╗██╗  ██╗ ██████╗ "
echo "  ██╔════╝ ██╔════╝████╗  ██║██║ ██╔╝██║ ██╔╝██╔═══██╗"
echo "  ██║  ███╗█████╗  ██╔██╗ ██║█████╔╝ █████╔╝ ██║   ██║"
echo "  ██║   ██║██╔══╝  ██║╚██╗██║██╔═██╗ ██╔═██╗ ██║   ██║"
echo "  ╚██████╔╝███████╗██║ ╚████║██║  ██╗██║  ██╗╚██████╔╝"
echo "   ╚═════╝ ╚══════╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ "
echo ""
echo "           SSHPLUS ARGENTINA - GENKKO EDITION"
echo ""
echo "=============================================="
echo ""
echo "  ATENCION: Este script instalara SSHPlus"
echo "  con soporte para SSH, HWID y TOKEN"
echo ""
echo "  Telegram: @GENKKOSSH"
echo ""
echo "=============================================="
echo ""
echo -n "Desea continuar con la instalacion? [s/n]: "; read x
[[ $x = @(n|N) ]] && exit

echo ""
echo "VERIFICANDO SISTEMA..."
sleep 1

# Repositorio
REPO="https://raw.githubusercontent.com/hayate25/genkkoplus/main"

# Actualizar sistema
echo ""
echo "--- ACTUALIZANDO SISTEMA ---"
apt-get update -y > /dev/null 2>&1
apt-get upgrade -y > /dev/null 2>&1

# Instalar paquetes necesarios
echo ""
echo "--- INSTALANDO PAQUETES ---"
apt-get install -y bc python3 htop git screen nano unzip lsof net-tools dos2unix nload jq curl figlet python3-pip at perl > /dev/null 2>&1
pip3 install speedtest-cli > /dev/null 2>&1

# Configurar firewall
echo ""
echo "--- CONFIGURANDO FIREWALL ---"
[[ -f "/usr/sbin/ufw" ]] && ufw allow 443/tcp ; ufw allow 80/tcp ; ufw allow 8080/tcp ; ufw allow 22/tcp

# Crear directorios
echo ""
echo "--- CREANDO DIRECTORIOS ---"
mkdir -p /etc/SSHPlus
mkdir -p /etc/SSHPlus/senha
mkdir -p /etc/SSHPlus/backups
touch /etc/SSHPlus/locked_users.db
touch /etc/SSHPlus/hwid.db
touch /etc/SSHPlus/token.db
touch /etc/SSHPlus/temp_users.db
touch /etc/SSHPlus/modo_actual.cfg
echo "SSH" > /etc/SSHPlus/modo_actual.cfg
echo "0" > /etc/SSHPlus/Exp

# Descargar modulos
echo ""
echo "--- INSTALANDO MODULOS ---"

MODULOS=(
    "ssh_manager"
    "hwid_manager"
    "token_manager"
    "remover"
    "bloquear"
    "menu"
    "alterarlimite"
    "alterarsenha"
    "mudardata"
    "infousers"
    "sshmonitor"
    "detalhes"
    "userbackup"
    "creardemo"
    "demo_cleaner"
    "bloquear_silencioso"
    "remover_silencioso"
    "editar_hwid"
    "expcleaner"
    "sshplus_auto_backup"
)

for modulo in "${MODULOS[@]}"; do
    echo "    Instalando $modulo..."
    wget -q "$REPO/Modulos/$modulo" -O /bin/$modulo 2>/dev/null
    chmod +x /bin/$modulo 2>/dev/null
done

# Crear comando menu rapido
echo "/bin/menu" > /bin/h
chmod +x /bin/h

# Configurar cron para demo_cleaner
(crontab -l 2>/dev/null | grep -v "demo_cleaner"; echo "*/5 * * * * /bin/demo_cleaner >> /tmp/demo_cleaner.log 2>&1") | crontab -

# Base de datos de usuarios
echo ""
echo "--- CONFIGURANDO BASE DE DATOS ---"
if [ -f "$HOME/usuarios.db" ]; then
    echo ""
    echo "  Se encontro una base de datos existente (usuarios.db)"
    echo "  [1] Mantener base de datos actual"
    echo "  [2] Crear nueva base de datos"
    echo ""
    echo -n "  Opcion [1-2]: "; read optiondb
    
    if [ "$optiondb" = "2" ]; then
        awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
    fi
else
    awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
fi

# Limpiar
echo ""
echo "--- FINALIZANDO ---"
rm -f $HOME/Plus 2>/dev/null
cat /dev/null > ~/.bash_history
history -c

clear
echo ""
echo "=============================================="
echo ""
echo "  ██████╗ ███████╗███╗   ██╗██╗  ██╗██╗  ██╗ ██████╗ "
echo "  ██╔════╝ ██╔════╝████╗  ██║██║ ██╔╝██║ ██╔╝██╔═══██╗"
echo "  ██║  ███╗█████╗  ██╔██╗ ██║█████╔╝ █████╔╝ ██║   ██║"
echo "  ██║   ██║██╔══╝  ██║╚██╗██║██╔═██╗ ██╔═██╗ ██║   ██║"
echo "  ╚██████╔╝███████╗██║ ╚████║██║  ██╗██║  ██╗╚██████╔╝"
echo "   ╚═════╝ ╚══════╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ "
echo ""
echo "=============================================="
echo ""
echo "  INSTALACION COMPLETADA EXITOSAMENTE"
echo ""
echo "  Comando principal: menu"
echo ""
echo "  Funciones:"
echo "    - SSH      (usuarios con contraseña)"
echo "    - HWID     (usuarios por identificador unico)"
echo "    - TOKEN    (usuarios por token)"
echo "    - DEMOS    (usuarios temporales)"
echo "    - BACKUP   (respaldo automatico .sshgenkko)"
echo ""
echo "  Telegram: @GENKKOSSH"
echo ""
echo "=============================================="
echo ""

exit 0
EOF

echo "✅ install.sh creado"