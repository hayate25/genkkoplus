#!/bin/bash
clear
[[ "$(whoami)" != "root" ]] && { echo "ERROR: Debes ejecutar como root"; exit 0; }
cd $HOME
echo "=============================================="
echo "           SSHPLUS - GENKKO EDITION"
echo "=============================================="
echo -n "Continuar? [s/n]: "; read x
[[ $x = @(n|N) ]] && exit
REPO="https://raw.githubusercontent.com/hayate25/genkkoplus/main"
echo "--- ACTUALIZANDO ---"
apt-get update -y > /dev/null 2>&1
apt-get install -y bc python3 htop git screen nano unzip lsof net-tools dos2unix nload jq curl figlet python3-pip at perl > /dev/null 2>&1
mkdir -p /etc/SSHPlus/senha /etc/SSHPlus/backups
touch /etc/SSHPlus/locked_users.db /etc/SSHPlus/hwid.db /etc/SSHPlus/token.db /etc/SSHPlus/temp_users.db
echo "SSH" > /etc/SSHPlus/modo_actual.cfg
echo "0" > /etc/SSHPlus/Exp
echo "--- INSTALANDO MODULOS ---"
MODULOS="ssh_manager hwid_manager token_manager remover bloquear menu alterarlimite alterarsenha mudardata infousers sshmonitor detalhes userbackup creardemo demo_cleaner bloquear_silencioso remover_silencioso editar_hwid expcleaner sshplus_auto_backup conexao badvpn banner limit_ssh monitor"
for modulo in $MODULOS; do
    echo "    $modulo..."
    wget -q "$REPO/Modulos/$modulo" -O /tmp/$modulo 2>/dev/null
    sed -i '1s/^\xEF\xBB\xBF//' /tmp/$modulo 2>/dev/null
    bash /tmp/$modulo 2>/dev/null
    chmod +x /bin/$modulo 2>/dev/null
    rm -f /tmp/$modulo
done
echo "/bin/menu" > /bin/h && chmod +x /bin/h
(crontab -l 2>/dev/null | grep -v "demo_cleaner"; echo "*/5 * * * * /bin/demo_cleaner >> /tmp/demo_cleaner.log 2>&1") | crontab - 2>/dev/null
if [ -f "$HOME/usuarios.db" ]; then
    echo -n "BD existente. [1] Mantener [2] Nueva: "; read optiondb
    [ "$optiondb" = "2" ] && awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
else
    awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
fi
cat /dev/null > ~/.bash_history && history -c
clear
echo "INSTALACION COMPLETADA - Comando: menu"
exit 0